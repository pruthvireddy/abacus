    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "maxItems": 20,
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "summary",
    "publishedAt",
    "source",
    "sections"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abacus.local/narada/report.schema.json",
  "title": "Narada source report"
}
