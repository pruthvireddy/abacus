                    "value": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "format": {
                      "enum": [
                        "number",
                        "percent"
                      ]
                    },
                    "unit": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40
                    },
                    "precision": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 6
                    },
                    "note": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 600
                    }
                  },
                  "required": [
                    "label",
                    "value",
                    "format"
                  ]
                },
                "maxItems": 24,
                "minItems": 1
              }
            },
            "required": [
              "id",
              "title",
              "kind",
              "items"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "maxLength": 80
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "kind": {
                "const": "table"
              },
              "columns": {
                "type": "array",
