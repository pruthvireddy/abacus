              "path": {
                "type": "string",
                "pattern": "^figures/[A-Za-z0-9][A-Za-z0-9._-]{0,100}\\.(png|jpg|jpeg|webp)$"
              },
              "alt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "caption": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
