                  "type": "object",
                  "maxProperties": 12,
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 1000
                      },
                      {
                        "type": [
                          "number",
                          "boolean",
                          "null"
