                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "format": {
                      "enum": [
                        "number",
                        "percent"
                      ]
                    },
                    "unit": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40
                    },
                    "precision": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 6
                    }
                  },
                  "required": [
                    "key",
                    "label"
                  ]
                },
                "maxItems": 12,
                "minItems": 1
              },
              "rows": {
                "type": "array",
