            draw_line(i, s6, s6_color, line_style, line_width)
            draw_label(i, array.get(s6, i), "L6", s6_color)
        if array.size(r2r3mid) > 0 and r2r3mid_show and p_look_back > array.size(arr_time)-2-i
            draw_line(i, r2r3mid, r2r3mid_color, mid_line_style, mid_line_width)
        if array.size(s2s3mid) > 0 and s2s3mid_show and p_look_back > array.size(arr_time)-2-i
            draw_line(i, s2s3mid, s2s3mid_color, mid_line_style, mid_line_width)
        if array.size(r3r4mid) > 0 and r3r4mid_show and p_look_back > array.size(arr_time)-2-i
