            draw_label_nextperiod(array.get(r6_next, 0), "H6", r6_color)
        if array.size(s6_next) > 0 and s6_show
            draw_line_nextperiod(s6_next, s6_color, line_style, line_width)
            draw_label_nextperiod(array.get(s6_next, 0), "L6", s6_color)

    if not enable_compact_mode and show_next_period_cpr
        if array.size(p_next) > 0 and p_show and enable_CPR
