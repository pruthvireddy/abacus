//@version=6
indicator("Camarilla Pivot Levels", "Camarilla Pivot Levels", overlay=true, behind_chart=false, max_lines_count=500, max_labels_count=500, max_boxes_count=500, dynamic_requests=false)

// --- Strategy Criteria: all controls below recalculate the loaded history. ---
const string CS_CRITERIA = "Strategy Criteria"
cs_enabled = input.bool(true, "Enable signals and statistics", group=CS_CRITERIA, tooltip="Requires standard 5-minute candles and daily-based Daily/Auto pivots. Tables study independent, possibly overlapping paths; no orders, stops or targets are simulated.")
cs_side = input.string("Both", "Trade direction", options=["Both", "Long only", "Short only"], group=CS_CRITERIA)
cs_levels = input.string("R3 / S3", "Reversal levels", options=["R3 / S3", "R4 / S4"], group=CS_CRITERIA)
cs_ema_mode = input.string("Cloud alignment", "EMA filter", options=["None", "Cloud alignment", "Price outside both EMAs", "Alignment + price outside"], group=CS_CRITERIA, tooltip="Long alignment: fast > slow; short: fast < slow. Price outside: close above both for longs, below both for shorts. Uses EMA Cloud TF/Fast/Slow controls. Higher-timeframe statistics always use confirmed EMAs, even if the visual cloud is developing.")
cs_approach = input.bool(true, "Require previous close and open on approach side", group=CS_CRITERIA, tooltip="Long: previous close > support and signal open >= support. Short: previous close < resistance and open <= resistance. Signal must touch the level/tolerance and close strictly back through the actual level.")
cs_body = input.bool(true, "Require directional candle body", group=CS_CRITERIA, tooltip="Long close > open; short close < open. Equality fails when enabled.")
cs_tolerance = input.int(0, "Contact tolerance (ticks)", minval=0, maxval=100, group=CS_CRITERIA, tooltip="Long low <= support + tolerance; short high >= resistance - tolerance. The close must still reclaim the actual level.")
cs_wick_ratio = input.float(0.0, "Minimum rejection wick / body (0 = off)", minval=0, maxval=20, step=0.25, group=CS_CRITERIA, tooltip="Lower wick for longs, upper wick for shorts. Body denominator is at least one tick.")
cs_approach_atr = input.float(0.0, "Minimum previous-close distance (ATR; 0 = off)", minval=0, maxval=20, step=0.1, group=CS_CRITERIA)
cs_penetration = input.float(0.0, "Maximum penetration beyond level (ATR; 0 = off)", minval=0, maxval=20, step=0.1, group=CS_CRITERIA)
cs_max_range = input.float(0.0, "Maximum signal true range / prior ATR (0 = off)", minval=0, maxval=20, step=0.1, group=CS_CRITERIA, tooltip="Uses ATR from before the signal so an oversized candle cannot inflate its comparison baseline.")
cs_skip_dual = input.bool(true, "Skip candles touching both selected levels", group=CS_CRITERIA)
cs_episode = input.bool(false, "One accepted signal per contact episode", group=CS_CRITERIA, tooltip="Rearm a long after a full candle low > support + tolerance; rearm a short after high < resistance - tolerance. Rejected candidates do not consume an episode. Episode state resets at a new daily pivot or a chart gap.")
cs_cooldown = input.int(10, "Cooldown after acceptance (candles)", minval=0, maxval=500, group=CS_CRITERIA, tooltip="Shared long/short clock. Suppresses exactly the next N candles; N+1 is eligible. Rejected signals do not restart it. Resets at each New York calendar date.")
cs_use_session = input.bool(true, "Restrict next-open entry window", group=CS_CRITERIA, inline="cs_session")
cs_session = input.session("0930-1130", "New York", group=CS_CRITERIA, inline="cs_session", tooltip="Entry open time, start inclusive/end exclusive. Overnight windows are supported. Paths can continue beyond this window.")
cs_weekdays = input.bool(true, "Monday–Friday entries only (New York)", group=CS_CRITERIA)
cs_volume = input.bool(false, "Require relative volume", group=CS_CRITERIA, inline="cs_volume")
cs_volume_multiple = input.float(1.0, "Minimum × prior mean", minval=0.1, maxval=20, step=0.1, group=CS_CRITERIA, inline="cs_volume")
cs_volume_length = input.int(20, "Volume mean length", minval=1, maxval=500, group=CS_CRITERIA)
cs_warmup = input.int(250, "Minimum loaded warmup candles", minval=0, maxval=10000, group=CS_CRITERIA, tooltip="Counts chart bars before allowing signals. Independent of ATR/EMA availability; 250 is the initial study choice for EMA 50.")
cs_first_year = input.int(2020, "First signal year (New York)", minval=2000, maxval=2100, group=CS_CRITERIA, inline="cs_year")
cs_last_year = input.int(2100, "Last", minval=2000, maxval=2100, group=CS_CRITERIA, inline="cs_year")

const string CS_MEASUREMENT = "Statistics / Measurement"
cs_atr_length = input.int(14, "ATR length (chart candles)", minval=1, maxval=500, group=CS_MEASUREMENT, tooltip="Normalize each event using ATR at its completed signal candle. Entry-bar and future ATR never change its denominator.")
cs_h1 = input.int(5, "Horizon 1", minval=1, maxval=500, group=CS_MEASUREMENT, inline="cs_h1")
cs_h2 = input.int(10, "Horizon 2", minval=1, maxval=500, group=CS_MEASUREMENT, inline="cs_h1")
cs_h3 = input.int(15, "Horizon 3", minval=1, maxval=500, group=CS_MEASUREMENT, inline="cs_h2")
cs_h4 = input.int(50, "Horizon 4", minval=1, maxval=500, group=CS_MEASUREMENT, inline="cs_h2")
cs_h5 = input.int(100, "Horizon 5", minval=1, maxval=500, group=CS_MEASUREMENT, inline="cs_h3")
cs_week_horizon = input.int(15, "Weekly close horizon", minval=1, maxval=500, group=CS_MEASUREMENT, inline="cs_h3")
cs_day_paths = input.bool(false, "End paths at next New York date", group=CS_MEASUREMENT, tooltip="Off: continue through contiguous bars, including overnight. On: cancel incomplete horizons at New York midnight. Every missing/short chart candle interrupts unfinished paths in either mode.")

const string CS_DISPLAY = "Statistics / Display"
cs_show_horizons = input.bool(true, "Show MAE / MFE horizon table", group=CS_DISPLAY)
cs_show_weeks = input.bool(true, "Show weekly outcome table", group=CS_DISPLAY)
cs_markers = input.bool(true, "Show accepted rejection markers", group=CS_DISPLAY)
cs_entry_marks = input.bool(false, "Show measured next-open entries", group=CS_DISPLAY)
cs_show_levels = input.bool(false, "Show exact daily levels used by statistics", group=CS_DISPLAY, tooltip="Confirmed prior daily HLC, independent of level visibility and next-period projections. Useful for checking parity with the supplied pivot drawings.")
cs_size = input.string("Small", "Table text size", options=["Tiny", "Small", "Normal"], group=CS_DISPLAY)
cs_top_position = input.string("Top right", "Horizon table position", options=["Top right", "Top left", "Top center", "Middle right"], group=CS_DISPLAY)
cs_week_position = input.string("Bottom right", "Weekly table position", options=["Bottom right", "Bottom left", "Bottom center", "Middle left"], group=CS_DISPLAY)
cs_week_rows = input.int(8, "Weeks per page", minval=1, maxval=20, group=CS_DISPLAY)
cs_week_page = input.int(1, "Week page (1 = latest)", minval=1, maxval=2000, group=CS_DISPLAY)


AUTO = "Auto"
DAILY = "Daily"
WEEKLY = "Weekly"
MONTHLY = "Monthly"
QUARTERLY = "Quarterly"
YEARLY = "Yearly"
BIYEARLY = "Biyearly"
TRIYEARLY = "Triyearly"
QUINQUENNIALLY = "Quinquennially"
DECENNIALLY = "Decennially"

ALERT_EVERYTIME = "Everytime"
ALERT_ONCE_PER_BAR = "Once Per Bar"
ALERT_ONCE_PER_BAR_CLOSE = "Once Per Bar Close"

pivot_time_frame = input.string(title="Pivots Timeframe", defval=AUTO, options=[AUTO, DAILY, WEEKLY, MONTHLY, QUARTERLY, YEARLY, BIYEARLY, TRIYEARLY, QUINQUENNIALLY, DECENNIALLY], group="Camarilla")
p_look_back = input.int(title="Number of Pivots Back", defval=1, minval=1, maxval=5000, group="Camarilla")
is_daily_based = input.bool(title="Use Daily-based Values", defval=true, tooltip="When this option is unchecked, Pivot Points will use intraday data while calculating on intraday charts. If Extended Hours are displayed on the chart, they will be taken into account during the pivot level calculation. If intraday OHLC values are different from daily-based values (normal for stocks), the pivot levels will also differ.", group="Camarilla")
enable_CPR = input.bool(title="Show CPR (Central Pivot Range)", defval=false, group="Central Pivot Range")
cpr_linestyle = input.string(defval = line.style_dashed, title = "CPR Line Style", options = [line.style_dashed, line.style_dotted, line.style_solid], group="Central Pivot Range")
cpr_linewidth = input.int(title="CPR Line Width", defval=1, minval=1, maxval=100, group="Central Pivot Range")
cpr_look_back = input.int(title="Number of CPR Back", defval=3, minval=1, maxval=5000, group="Central Pivot Range")
show_next_period = input.bool(title="Show Next Period's Pivots", defval=false, group="Next Period")
show_next_period_cpr = input.bool(title="Show Next Period's CPR", defval=false, group="Next Period", tooltip="'Show CPR' must be checked.")
enable_timereq = input.bool(title="Only after 50% of current period is complete", defval=true, group="Next Period", tooltip="There might not be enough data in the beginning of the session to show accurate pivots for the next period.")
nextperiod_offset = input.int(title="Offset X", defval=15, group="Next Period")

show_labels = input.bool(title="Show Labels", defval=true, group="labels", inline="showlabels")
show_prices = input.bool(title="Show Prices", defval=false, group="labels", inline="showlabels")
show_timeframe_in_labels = input.bool(title="Show timeframe in labels", defval=true, group="labels")
position_labels = input.string("Right", "Labels Position", options=["Left", "Right"], group="labels")
position_pivot_label = input.string("Left", "Pivot/CPR Label Position", options=["Left", "Right"], group="labels")
line_width = input.int(title="Line Width", defval=1, minval=1, maxval=100, group="levels", inline="pivotstyle")
line_style = input.string(defval = line.style_solid, title = "Line Style", options = [line.style_dashed, line.style_dotted, line.style_solid], group="levels", inline="pivotstyle")

l3_l4_zone_show = input.bool(false, "L3 L4 Zone", inline="L3/L4 Zone", group="Zones")
l3_l4_zone_color = input.color(color.new(#31E981, 60), "", inline="L3/L4 Zone", group="Zones")
h3_h4_zone_show = input.bool(false, "H3 H4 Zone", inline="H3/H4 Zone", group="Zones")
h3_h4_zone_color = input.color(color.new(#F23645, 60), "", inline="H3/H4 Zone", group="Zones")
l4_l6_zone_show = input.bool(false, "L4 L6 Zone", inline="L4/L6 Zone", group="Zones")
l4_l6_zone_color = input.color(color.new(#9C27B0, 60), "", inline="L4/L6 Zone", group="Zones")
h4_h6_zone_show = input.bool(false, "H4 H6 Zone", inline="H4/H6 Zone", group="Zones")
h4_h6_zone_color = input.color(color.new(#9C27B0, 60), "", inline="H4/H6 Zone", group="Zones")
show_only_zones = input.bool(false, "Show only zones (hide lines)", group="Zones")

mid_line_width = input.int(title="Line Width", defval=1, minval=1, maxval=100, group="Midlines", inline="midstyle")
mid_line_style = input.string(defval = line.style_dotted, title = "Line Style", options = [line.style_dashed, line.style_dotted, line.style_solid], group="Midlines", inline="midstyle")

look_back = math.max(p_look_back, cpr_look_back)
