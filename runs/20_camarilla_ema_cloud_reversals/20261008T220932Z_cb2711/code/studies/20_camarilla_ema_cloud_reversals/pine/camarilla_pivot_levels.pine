// EMA cloud added to the user-supplied Camarilla indicator.
// Same-timeframe EMAs use chart bars without an additional bar of delay.
// Higher-timeframe clouds use completed source bars by default.
ema_cloud_show = input.bool(true, "Show", inline="cloud_tf", group="EMA Cloud")
ema_cloud_tf = input.timeframe("5", "TF", inline="cloud_tf", group="EMA Cloud")
ema_cloud_fast_length = input.int(20, "Fast", minval=1, inline="cloud_lengths", group="EMA Cloud")
ema_cloud_slow_length = input.int(50, "Slow", minval=1, inline="cloud_lengths", group="EMA Cloud")
ema_cloud_up = input.color(color.new(#089981, 80), "Up", inline="cloud_colors", group="EMA Cloud")
ema_cloud_down = input.color(color.new(#F23645, 80), "Down", inline="cloud_colors", group="EMA Cloud")
ema_cloud_show_lines = input.bool(true, "Show EMA boundaries", group="EMA Cloud")
ema_cloud_confirmed_htf = input.bool(true, "Use confirmed higher-timeframe bars", group="EMA Cloud", tooltip="Applies only when the cloud timeframe is above the chart timeframe. Completed source bars give consistent historical and live values. Uncheck to display a developing higher-timeframe cloud, which can change after reload. On the same timeframe, the open candle's cloud develops normally; use its completed values for signals.")

ema_cloud_chart_seconds = timeframe.in_seconds()
ema_cloud_seconds = timeframe.in_seconds(ema_cloud_tf)
ema_cloud_is_htf = ema_cloud_seconds > ema_cloud_chart_seconds
if ema_cloud_show and ema_cloud_seconds < ema_cloud_chart_seconds
    runtime.error("EMA Cloud TF must be equal to or above the chart timeframe. For a 5-minute EMA cloud, use a 5-minute or lower chart, or turn off Show in EMA Cloud.")

ema_cloud_chart_fast = ta.ema(close, ema_cloud_fast_length)
ema_cloud_chart_slow = ta.ema(close, ema_cloud_slow_length)
[ema_cloud_requested_fast, ema_cloud_requested_slow] = request.security(syminfo.tickerid, ema_cloud_tf, [ta.ema(close, ema_cloud_fast_length), ta.ema(close, ema_cloud_slow_length)], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[ema_cloud_confirmed_fast, ema_cloud_confirmed_slow] = request.security(syminfo.tickerid, ema_cloud_tf, [ta.ema(close, ema_cloud_fast_length)[1], ta.ema(close, ema_cloud_slow_length)[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
ema_cloud_fast = ema_cloud_is_htf ? (ema_cloud_confirmed_htf ? ema_cloud_confirmed_fast : ema_cloud_requested_fast) : ema_cloud_chart_fast
ema_cloud_slow = ema_cloud_is_htf ? (ema_cloud_confirmed_htf ? ema_cloud_confirmed_slow : ema_cloud_requested_slow) : ema_cloud_chart_slow
ema_cloud_bullish = ema_cloud_fast > ema_cloud_slow
ema_cloud_bearish = ema_cloud_fast < ema_cloud_slow
ema_cloud_fill_color = ema_cloud_bullish ? ema_cloud_up : ema_cloud_bearish ? ema_cloud_down : na
ema_cloud_boundary_color = ema_cloud_bullish ? color.new(ema_cloud_up, 0) : ema_cloud_bearish ? color.new(ema_cloud_down, 0) : color.gray
ema_cloud_fast_plot = plot(ema_cloud_show ? ema_cloud_fast : na, title="EMA Cloud Fast", color=ema_cloud_show_lines ? ema_cloud_boundary_color : na, linewidth=1)
ema_cloud_slow_plot = plot(ema_cloud_show ? ema_cloud_slow : na, title="EMA Cloud Slow", color=ema_cloud_show_lines ? ema_cloud_boundary_color : na, linewidth=1)
fill(ema_cloud_fast_plot, ema_cloud_slow_plot, color=ema_cloud_show ? ema_cloud_fill_color : na, title="EMA Cloud", fillgaps=false)

// --- Chart-local rejection event statistics (not a strategy order simulator). ---
const string CS_TZ = "America/New_York"
const int CS_BAR_MS = 300000
const color CS_BG = #151515
const color CS_BORDER = #353535
const color CS_TEXT = #d6d6d6
const color CS_MUTED = #909090
const color CS_MFE = #00b3a4
const color CS_MAE = #ff3048

csReject(int direction, float candleOpen, float candleHigh, float candleLow, float candleClose, float previousClose, float level, float atrValue, float tick, float tolerance, bool approachRequired, bool bodyRequired, float wickRatio, float approachAtr, float maxPenetration) =>
    float tol = tolerance * tick
    bool touch = candleLow <= level + tol
    bool reclaim = candleClose > level
    bool approach = previousClose > level and candleOpen >= level
    bool body = candleClose > candleOpen
    float wick = math.min(candleOpen, candleClose) - candleLow
    float distance = previousClose - level
    float penetration = math.max(0.0, level - candleLow)
    if direction == -1
        touch := candleHigh >= level - tol
        reclaim := candleClose < level
        approach := previousClose < level and candleOpen <= level
        body := candleClose < candleOpen
        wick := candleHigh - math.max(candleOpen, candleClose)
        distance := level - previousClose
        penetration := math.max(0.0, candleHigh - level)
    bool wickPass = wickRatio <= 0 or wick >= wickRatio * math.max(tick, math.abs(candleClose - candleOpen))
    bool distancePass = approachAtr <= 0 or distance >= approachAtr * atrValue
    bool penetrationPass = maxPenetration <= 0 or penetration <= maxPenetration * atrValue
    touch and reclaim and (not approachRequired or approach) and (not bodyRequired or body) and wickPass and distancePass and penetrationPass

csCloudPass(int direction, float signalClose, float fast, float slow, string mode) =>
    bool aligned = fast > slow
    bool outside = signalClose > math.max(fast, slow)
    if direction == -1
        aligned := fast < slow
        outside := signalClose < math.min(fast, slow)
    bool pass = mode == "None"
    if mode == "Cloud alignment"
        pass := aligned
    else if mode == "Price outside both EMAs"
        pass := outside
    else if mode == "Alignment + price outside"
        pass := aligned and outside
    pass

csSizePass(float maximum, float signalTR, float priorAtr) =>
    maximum <= 0 or (not na(priorAtr) and priorAtr > 0 and signalTR <= maximum * priorAtr)

csAccept(bool candidate, int index, int lastIndex, int cooldown) =>
    candidate and (na(lastIndex) or index - lastIndex > cooldown)

csExcursions(int direction, float entry, float minimumPrice, float maximumPrice, float terminalClose, float frozenAtr) =>
    float favorable = math.max(0.0, maximumPrice - entry) / frozenAtr
    float adverse = math.max(0.0, entry - minimumPrice) / frozenAtr
    if direction == -1
        favorable := math.max(0.0, entry - minimumPrice) / frozenAtr
        adverse := math.max(0.0, maximumPrice - entry) / frozenAtr
    float delta = direction * (terminalClose - entry) / frozenAtr
    [favorable, adverse, delta]

csEntryAllowed(int direction, int signalCloseTime, int currentOpenTime, bool fullBar, bool contiguous, bool dateAllowed) =>
    direction != 0 and currentOpenTime == signalCloseTime and fullBar and contiguous and dateAllowed

csDateKey(int at) =>
    timestamp("UTC", year(at, CS_TZ), month(at, CS_TZ), dayofmonth(at, CS_TZ), 0, 0)

csWeekKey(int at) =>
    int daysSinceMonday = (dayofweek(at, CS_TZ) - dayofweek.monday + 7) % 7
    csDateKey(at) - daysSinceMonday * 86400000

csClockPass(int clockNow, int start, int finish, bool enabled, bool weekdaysOnly, bool weekday) =>
    bool inside = start == finish
    if finish > start
        inside := clockNow >= start and clockNow < finish
    else if finish < start
        inside := clockNow >= start or clockNow < finish
    (not enabled or inside) and (not weekdaysOnly or weekday)

csWindowPass(int at, string spec, bool enabled, bool weekdaysOnly) =>
    int start = int(str.tonumber(str.substring(spec, 0, 2))) * 60 + int(str.tonumber(str.substring(spec, 2, 4)))
    int finish = int(str.tonumber(str.substring(spec, 5, 7))) * 60 + int(str.tonumber(str.substring(spec, 7, 9)))
    int clockNow = hour(at, CS_TZ) * 60 + minute(at, CS_TZ)
    bool weekday = dayofweek(at, CS_TZ) >= dayofweek.monday and dayofweek(at, CS_TZ) <= dayofweek.friday
    csClockPass(clockNow, start, finish, enabled, weekdaysOnly, weekday)

csPosition(string where) =>
    switch where
        "Top left" => position.top_left
        "Top center" => position.top_center
        "Middle right" => position.middle_right
        "Bottom left" => position.bottom_left
        "Bottom center" => position.bottom_center
        "Middle left" => position.middle_left
        "Bottom right" => position.bottom_right
        => position.top_right

csNumber(float total, int n) =>
    n > 0 ? str.tostring(total / n, "0.00") : "—"

csPercent(int numerator, int n) =>
    n > 0 ? str.tostring(100.0 * numerator / n, "0.0") + "%" : "—"

type CsPath
    int direction
    float entry
    float atr
    float lowest
    float highest
    int age
    int weekIndex
    int dateKey

var array<CsPath> cs_paths = array.new<CsPath>()
var array<int> cs_horizons = array.from(cs_h1, cs_h2, cs_h3, cs_h4, cs_h5)
var array<int> cs_samples = array.new<int>(5, 0)
var array<float> cs_mfe_sum = array.new<float>(5, 0.0)
var array<float> cs_mae_sum = array.new<float>(5, 0.0)
var array<float> cs_delta_sum = array.new<float>(5, 0.0)
var array<int> cs_favorable = array.new<int>(5, 0)
var array<int> cs_mfe_greater = array.new<int>(5, 0)
var array<int> cs_weeks = array.new<int>()
var array<int> cs_week_accepted = array.new<int>()
var array<int> cs_week_n = array.new<int>()
var array<int> cs_week_positive = array.new<int>()
var array<float> cs_week_delta = array.new<float>()
var int cs_last_accepted = na
var int cs_pending_direction = 0
var float cs_pending_atr = na
var int cs_pending_at = na
var int cs_pending_week = na
var int cs_pending_date = na
var int cs_accepted_total = 0
var int cs_entered_total = 0
var int cs_cancelled_entries = 0
var int cs_interrupted_paths = 0
var bool cs_long_armed = true
var bool cs_short_armed = true

// An explicitly offset daily request keeps the statistics independent of the
// inherited current-period projection and last-premarket drawing paths.
[cs_previous_high, cs_previous_low, cs_previous_close] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
float cs_daily_range = cs_previous_high - cs_previous_low
float cs_coefficient = cs_levels == "R3 / S3" ? 0.275 : 0.55
float cs_support = cs_previous_close - cs_coefficient * cs_daily_range
float cs_resistance = cs_previous_close + cs_coefficient * cs_daily_range
float cs_atr = ta.atr(cs_atr_length)
float cs_prior_volume_mean = ta.sma(volume, cs_volume_length)[1]
float cs_stats_fast = ema_cloud_is_htf ? ema_cloud_confirmed_fast : ema_cloud_chart_fast
float cs_stats_slow = ema_cloud_is_htf ? ema_cloud_confirmed_slow : ema_cloud_chart_slow
bool cs_contiguous = not na(time_close[1]) and time == time_close[1]
bool cs_full_bar = time_close - time == CS_BAR_MS and not na(open) and not na(high) and not na(low) and not na(close)
int cs_signal_date = csDateKey(time_close)
bool cs_year_in_scope = year(time_close, CS_TZ) >= cs_first_year and year(time_close, CS_TZ) <= cs_last_year
bool cs_new_date = not na(time_close[1]) and cs_signal_date != csDateKey(time_close[1])
bool cs_new_pivot = ta.change(time("D")) != 0
bool cs_long_signal = false
bool cs_short_signal = false
bool cs_entered_now = false
int cs_entry_direction = 0
int cs_max_horizon = math.max(array.max(cs_horizons), cs_week_horizon)

if barstate.isfirst and cs_enabled
    if not chart.is_standard or timeframe.in_seconds() != 300
        runtime.error("Strategy statistics require standard 5-minute candles. Disable Enable signals and statistics to use the visual indicator on another chart.")
    if resolution != "D" or not is_daily_based
        runtime.error("Strategy statistics use confirmed previous-day Camarilla levels. Select Daily (or Auto on 5 minutes) and Use Daily-based Values.")
    if ema_cloud_seconds < 300 and cs_ema_mode != "None"
        runtime.error("For statistics, EMA Cloud TF must be 5 minutes or higher.")
    if cs_first_year > cs_last_year
        runtime.error("First signal year must not exceed last signal year.")

if barstate.isconfirmed and cs_enabled
    if cs_new_date
        cs_last_accepted := na
    if cs_new_pivot or not cs_contiguous
        cs_long_armed := true
        cs_short_armed := true

    // Create every observed in-scope week, even if it has no eligible signals.
    if cs_year_in_scope
        int weekKey = csWeekKey(time_close)
        if array.size(cs_weeks) == 0 or array.last(cs_weeks) != weekKey
            array.push(cs_weeks, weekKey)
            array.push(cs_week_accepted, 0)
            array.push(cs_week_n, 0)
            array.push(cs_week_positive, 0)
            array.push(cs_week_delta, 0.0)

    // A confirmation becomes measurable only at the following contiguous open.
    // The entry bar's OHLC is consumed at its close; signal-bar extremes are absent.
    if cs_pending_direction != 0
        bool dateAllowed = not cs_day_paths or csDateKey(time) == cs_pending_date
        if csEntryAllowed(cs_pending_direction, cs_pending_at, time, cs_full_bar, cs_contiguous, dateAllowed)
            array.push(cs_paths, CsPath.new(cs_pending_direction, open, cs_pending_atr, open, open, 0, cs_pending_week, csDateKey(time)))
            cs_entered_total += 1
            cs_entered_now := true
            cs_entry_direction := cs_pending_direction
        else
            cs_cancelled_entries += 1
        cs_pending_direction := 0

    if array.size(cs_paths) > 0
        for i = array.size(cs_paths) - 1 to 0
            CsPath path = array.get(cs_paths, i)
            bool pathValid = cs_contiguous and cs_full_bar and (not cs_day_paths or csDateKey(time) == path.dateKey)
            if not pathValid
                cs_interrupted_paths += 1
                array.remove(cs_paths, i)
            else
                path.age += 1
                path.lowest := math.min(path.lowest, low)
                path.highest := math.max(path.highest, high)
                [eventMfe, eventMae, eventDelta] = csExcursions(path.direction, path.entry, path.lowest, path.highest, close, path.atr)
                for h = 0 to 4
                    if path.age == array.get(cs_horizons, h)
                        array.set(cs_samples, h, array.get(cs_samples, h) + 1)
                        array.set(cs_mfe_sum, h, array.get(cs_mfe_sum, h) + eventMfe)
                        array.set(cs_mae_sum, h, array.get(cs_mae_sum, h) + eventMae)
                        array.set(cs_delta_sum, h, array.get(cs_delta_sum, h) + eventDelta)
                        array.set(cs_favorable, h, array.get(cs_favorable, h) + (eventDelta > 0 ? 1 : 0))
                        array.set(cs_mfe_greater, h, array.get(cs_mfe_greater, h) + (eventMfe > eventMae ? 1 : 0))
                if path.age == cs_week_horizon
                    int w = path.weekIndex
                    array.set(cs_week_n, w, array.get(cs_week_n, w) + 1)
                    array.set(cs_week_positive, w, array.get(cs_week_positive, w) + (eventDelta > 0 ? 1 : 0))
                    array.set(cs_week_delta, w, array.get(cs_week_delta, w) + eventDelta)
                if path.age >= cs_max_horizon
                    array.remove(cs_paths, i)

    bool ready = cs_full_bar and cs_contiguous and cs_year_in_scope and bar_index >= cs_warmup and not na(cs_atr) and cs_atr > 0 and not na(cs_daily_range) and cs_daily_range > 0 and not na(close[1])
    bool cloudReady = cs_ema_mode == "None" or (not na(cs_stats_fast) and not na(cs_stats_slow))
    bool volumePass = not cs_volume or (not na(volume) and not na(cs_prior_volume_mean) and cs_prior_volume_mean > 0 and volume >= cs_volume_multiple * cs_prior_volume_mean)
    bool sharedPass = ready and cloudReady and volumePass and csSizePass(cs_max_range, ta.tr(true), cs_atr[1]) and csWindowPass(time_close, cs_session, cs_use_session, cs_weekdays)
    float tolerancePrice = cs_tolerance * syminfo.mintick
    bool touchesBoth = low <= cs_support + tolerancePrice and high >= cs_resistance - tolerancePrice
    if low > cs_support + tolerancePrice
        cs_long_armed := true
    if high < cs_resistance - tolerancePrice
        cs_short_armed := true
    bool longCandidate = sharedPass and (cs_side != "Short only") and (not cs_skip_dual or not touchesBoth) and (not cs_episode or cs_long_armed) and csReject(1, open, high, low, close, close[1], cs_support, cs_atr, syminfo.mintick, cs_tolerance, cs_approach, cs_body, cs_wick_ratio, cs_approach_atr, cs_penetration) and csCloudPass(1, close, cs_stats_fast, cs_stats_slow, cs_ema_mode)
    bool shortCandidate = sharedPass and (cs_side != "Long only") and (not cs_skip_dual or not touchesBoth) and (not cs_episode or cs_short_armed) and csReject(-1, open, high, low, close, close[1], cs_resistance, cs_atr, syminfo.mintick, cs_tolerance, cs_approach, cs_body, cs_wick_ratio, cs_approach_atr, cs_penetration) and csCloudPass(-1, close, cs_stats_fast, cs_stats_slow, cs_ema_mode)
    // A candle satisfying both directions is ambiguous and always excluded.
    int candidateDirection = longCandidate and not shortCandidate ? 1 : shortCandidate and not longCandidate ? -1 : 0
    if csAccept(candidateDirection != 0, bar_index, cs_last_accepted, cs_cooldown)
        cs_last_accepted := bar_index
        cs_accepted_total += 1
        cs_pending_direction := candidateDirection
        cs_pending_atr := cs_atr
        cs_pending_at := time_close
        cs_pending_week := array.size(cs_weeks) - 1
        cs_pending_date := cs_signal_date
        array.set(cs_week_accepted, cs_pending_week, array.get(cs_week_accepted, cs_pending_week) + 1)
        cs_long_signal := candidateDirection == 1
        cs_short_signal := candidateDirection == -1
        if cs_long_signal
            cs_long_armed := false
        else
            cs_short_armed := false

plotshape(cs_enabled and cs_markers and cs_long_signal, title="Accepted S reversal", style=shape.triangleup, location=location.belowbar, color=CS_MFE, size=size.tiny, text="S REV")
plotshape(cs_enabled and cs_markers and cs_short_signal, title="Accepted R reversal", style=shape.triangledown, location=location.abovebar, color=CS_MAE, size=size.tiny, text="R REV")
plot(cs_enabled and cs_entry_marks and cs_entered_now ? open : na, title="Measured next-open entry", color=cs_entry_direction == 1 ? CS_MFE : CS_MAE, style=plot.style_circles, linewidth=3)
plot(cs_enabled and cs_show_levels ? cs_support : na, title="Statistics S level (confirmed daily)", color=color.new(CS_MFE, 35), style=plot.style_stepline)
plot(cs_enabled and cs_show_levels ? cs_resistance : na, title="Statistics R level (confirmed daily)", color=color.new(CS_MAE, 35), style=plot.style_stepline)
alertcondition(cs_long_signal, "Accepted S reversal", "Accepted Camarilla support rejection after Strategy Criteria.")
alertcondition(cs_short_signal, "Accepted R reversal", "Accepted Camarilla resistance rejection after Strategy Criteria.")

string cs_text_size = cs_size == "Tiny" ? size.tiny : cs_size == "Normal" ? size.normal : size.small
var table cs_horizon_table = table.new(csPosition(cs_top_position), 7, 9, bgcolor=CS_BG, frame_color=CS_BORDER, frame_width=1, border_color=CS_BORDER, border_width=1)
var table cs_week_table = table.new(csPosition(cs_week_position), 4, cs_week_rows + 4, bgcolor=CS_BG, frame_color=CS_BORDER, frame_width=1, border_color=CS_BORDER, border_width=1)
if barstate.isfirst
    table.merge_cells(cs_horizon_table, 0, 0, 6, 0)
    table.merge_cells(cs_horizon_table, 0, 7, 6, 7)
    table.merge_cells(cs_horizon_table, 0, 8, 6, 8)
    table.merge_cells(cs_week_table, 0, cs_week_rows + 2, 3, cs_week_rows + 2)
    table.merge_cells(cs_week_table, 0, cs_week_rows + 3, 3, cs_week_rows + 3)

if barstate.islast
    string criteriaCaption = cs_levels + " reversals | " + cs_side + " | " + cs_ema_mode + " | C" + str.tostring(cs_cooldown)
    string entryCaption = "Next open | ATR(" + str.tostring(cs_atr_length) + ") at signal | " + (cs_use_session ? cs_session + " NY" : "All entry times") + " | Loaded history only"
    if cs_enabled and cs_show_horizons
        table.cell(cs_horizon_table, 0, 0, criteriaCaption, bgcolor=CS_BG, text_color=CS_TEXT, text_size=cs_text_size)
        array<string> headings = array.from("Bars", "N", "AVG MFE (ATR)", "AVG MAE (ATR)", "AVG CLOSE Δ (ATR)", "FAVORABLE CLOSE", "MFE > MAE")
        for c = 0 to 6
            table.cell(cs_horizon_table, c, 1, array.get(headings, c), bgcolor=CS_BG, text_color=c == 2 ? CS_MFE : c == 3 ? CS_MAE : CS_MUTED, text_size=cs_text_size)
        for h = 0 to 4
            int row = h + 2
            int n = array.get(cs_samples, h)
            float deltaSum = array.get(cs_delta_sum, h)
            table.cell(cs_horizon_table, 0, row, str.tostring(array.get(cs_horizons, h)), bgcolor=CS_BG, text_color=CS_TEXT, text_size=cs_text_size)
            table.cell(cs_horizon_table, 1, row, str.tostring(n), bgcolor=CS_BG, text_color=CS_TEXT, text_size=cs_text_size)
            table.cell(cs_horizon_table, 2, row, csNumber(array.get(cs_mfe_sum, h), n), bgcolor=CS_BG, text_color=CS_MFE, text_size=cs_text_size)
            table.cell(cs_horizon_table, 3, row, csNumber(array.get(cs_mae_sum, h), n), bgcolor=CS_BG, text_color=CS_MAE, text_size=cs_text_size)
            table.cell(cs_horizon_table, 4, row, csNumber(deltaSum, n), bgcolor=CS_BG, text_color=n == 0 ? CS_MUTED : deltaSum >= 0 ? CS_MFE : CS_MAE, text_size=cs_text_size)
            table.cell(cs_horizon_table, 5, row, csPercent(array.get(cs_favorable, h), n), bgcolor=CS_BG, text_color=CS_TEXT, text_size=cs_text_size)
            table.cell(cs_horizon_table, 6, row, csPercent(array.get(cs_mfe_greater, h), n), bgcolor=CS_BG, text_color=CS_TEXT, text_size=cs_text_size)
        table.cell(cs_horizon_table, 0, 7, entryCaption, bgcolor=CS_BG, text_color=CS_MUTED, text_size=size.tiny)
        string status = "Accepted " + str.tostring(cs_accepted_total) + " | Entered " + str.tostring(cs_entered_total) + " | Entry cancelled " + str.tostring(cs_cancelled_entries) + " | Paths interrupted " + str.tostring(cs_interrupted_paths) + " | Active " + str.tostring(array.size(cs_paths)) + " | Pending " + str.tostring(cs_pending_direction != 0 ? 1 : 0)
        table.cell(cs_horizon_table, 0, 8, status, bgcolor=CS_BG, text_color=CS_MUTED, text_size=size.tiny)
    else
        table.clear(cs_horizon_table, 0, 0, 6, 8)

    if cs_enabled and cs_show_weeks
        int count = array.size(cs_weeks)
        int pages = math.max(1, int(math.ceil(float(count) / cs_week_rows)))
        int page = math.min(cs_week_page, pages)
        int totalN = count > 0 ? array.sum(cs_week_n) : 0
        int totalPositive = count > 0 ? array.sum(cs_week_positive) : 0
        float totalDelta = count > 0 ? array.sum(cs_week_delta) : 0.0
        table.cell(cs_week_table, 0, 0, "WEEK START / NY MON", bgcolor=CS_BG, text_color=CS_MUTED, text_size=cs_text_size)
        table.cell(cs_week_table, 1, 0, "ACCEPTED C" + str.tostring(cs_cooldown), bgcolor=CS_BG, text_color=CS_MFE, text_size=cs_text_size)
        table.cell(cs_week_table, 2, 0, "FAVORABLE CLOSE @ " + str.tostring(cs_week_horizon) + " BARS", bgcolor=CS_BG, text_color=CS_MUTED, text_size=cs_text_size)
        table.cell(cs_week_table, 3, 0, "AVG CLOSE Δ (ATR)", bgcolor=CS_BG, text_color=CS_MUTED, text_size=cs_text_size)
        table.cell(cs_week_table, 0, 1, "Σ loaded", bgcolor=CS_BG, text_color=CS_TEXT, text_size=cs_text_size)
        table.cell(cs_week_table, 1, 1, str.tostring(cs_accepted_total), bgcolor=CS_BG, text_color=CS_MFE, text_size=cs_text_size)
        table.cell(cs_week_table, 2, 1, csPercent(totalPositive, totalN) + " (N=" + str.tostring(totalN) + ")", bgcolor=CS_BG, text_color=CS_TEXT, text_size=cs_text_size)
        table.cell(cs_week_table, 3, 1, csNumber(totalDelta, totalN), bgcolor=CS_BG, text_color=totalN == 0 ? CS_MUTED : totalDelta >= 0 ? CS_MFE : CS_MAE, text_size=cs_text_size)
        for offset = 0 to cs_week_rows - 1
            int w = count - 1 - (page - 1) * cs_week_rows - offset
            int row = offset + 2
            bool exists = w >= 0
            int n = exists ? array.get(cs_week_n, w) : 0
            float deltaSum = exists ? array.get(cs_week_delta, w) : 0.0
            color bg = w == count - 1 and exists ? #1a2c25 : CS_BG
            table.cell(cs_week_table, 0, row, exists ? str.format_time(array.get(cs_weeks, w), "yyyy-MM-dd", "UTC") : "—", bgcolor=bg, text_color=CS_TEXT, text_size=cs_text_size)
            table.cell(cs_week_table, 1, row, exists ? str.tostring(array.get(cs_week_accepted, w)) : "—", bgcolor=bg, text_color=CS_MFE, text_size=cs_text_size)
            table.cell(cs_week_table, 2, row, exists ? csPercent(array.get(cs_week_positive, w), n) + " (N=" + str.tostring(n) + ")" : "—", bgcolor=bg, text_color=CS_TEXT, text_size=cs_text_size)
            table.cell(cs_week_table, 3, row, exists ? csNumber(deltaSum, n) : "—", bgcolor=bg, text_color=n == 0 ? CS_MUTED : deltaSum >= 0 ? CS_MFE : CS_MAE, text_size=cs_text_size)
        table.cell(cs_week_table, 0, cs_week_rows + 2, "MON–SUN NY | " + cs_side + " | N = completed horizons | Signal-close week | Page " + str.tostring(page) + "/" + str.tostring(pages), bgcolor=CS_BG, text_color=CS_MUTED, text_size=size.tiny)
        table.cell(cs_week_table, 0, cs_week_rows + 3, "Partial boundary weeks possible | Overlapping raw paths | No stops, targets or costs", bgcolor=CS_BG, text_color=CS_MUTED, text_size=size.tiny)
    else
        table.clear(cs_week_table, 0, 0, 3, cs_week_rows + 3)
