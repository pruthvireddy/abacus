        0 => selectNFP
        1 => selectCPI
        2 => selectFOMC
        3 => selectFedConference
        4 => selectFlashPMI
        5 => selectISM
        6 => selectECB
        7 => selectECBConference
        => false
    enabled and (category <= 5 ? selectUSD : selectEUR)

