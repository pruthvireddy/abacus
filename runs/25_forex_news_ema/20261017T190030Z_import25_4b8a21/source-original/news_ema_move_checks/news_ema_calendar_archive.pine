archiveCategoryName(int category) =>
    switch category
        0 => "U.S. NFP / unemployment / earnings"
        1 => "U.S. CPI / core CPI"
        2 => "FOMC decision / projections"
        3 => "FOMC press conference"
        4 => "U.S. flash PMI"
        5 => "U.S. ISM manufacturing"
        6 => "ECB rate decision"
