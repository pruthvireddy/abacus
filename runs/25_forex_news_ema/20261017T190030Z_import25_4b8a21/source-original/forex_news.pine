string chartHistory = input.string("This Week", "Chart history", group = "Chart Markers", inline = "history", options = ["Today", "This Week", "Manual"])
int chartLookbackDays = input.int(30, "days", group = "Chart Markers", inline = "history", minval = 1, maxval = 180, tooltip = chartHistoryTooltip)
bool markersFollowEventSelection = input.bool(true, "Lines and labels follow Events To Shade", group = "Chart Markers")
bool showHoverMarkers = input.bool(true, "Hover circles for shaded events", group = "Chart Markers", inline = "hover")
