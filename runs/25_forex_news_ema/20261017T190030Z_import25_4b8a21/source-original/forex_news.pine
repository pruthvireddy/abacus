import toodegrees/forex_factory_utility/17 as ffUtil
import toodegrees/forex_factory_decoding/46 as ffDec

indicator("Forex News", shorttitle = "Forex News", overlay = true, max_lines_count = 500, max_labels_count = 500)


// ─────────────────────────────────────────────────────────────────────────────
// Timeframe support
// ─────────────────────────────────────────────────────────────────────────────
int chartSeconds = timeframe.in_seconds(timeframe.period)
if chartSeconds > 86400
    runtime.error("Forex News supports the Daily timeframe or lower.")
else if chartSeconds < 30
    runtime.error("Forex News supports the 30-second timeframe or higher.")


// ─────────────────────────────────────────────────────────────────────────────
// Feed helpers
// ─────────────────────────────────────────────────────────────────────────────
var bool midnightDetected = false
if hour(time, "America/New_York") == 0 and hour(time[1], "America/New_York") != 0 and not midnightDetected
    midnightDetected := true

bool newDay = midnightDetected ? hour(time, "America/New_York") == 0 and hour(time[1], "America/New_York") != 0 : timeframe.change("D")

requestData() =>
    [request.seed("seed_toodegrees_toogit", "TOODEGREES_FOREX_FACTORY_SLOT_1", str.tostring(open) + "," + str.tostring(high) + "," + str.tostring(low) + "," + str.tostring(close) + "," + str.tostring(volume)),
     request.seed("seed_toodegrees_toogit", "TOODEGREES_FOREX_FACTORY_SLOT_2", str.tostring(open) + "," + str.tostring(high) + "," + str.tostring(low) + "," + str.tostring(close) + "," + str.tostring(volume)),
     request.seed("seed_toodegrees_toogit", "TOODEGREES_FOREX_FACTORY_SLOT_3", str.tostring(open) + "," + str.tostring(high) + "," + str.tostring(low) + "," + str.tostring(close) + "," + str.tostring(volume)),
     request.seed("seed_toodegrees_toogit", "TOODEGREES_FOREX_FACTORY_SLOT_4", str.tostring(open) + "," + str.tostring(high) + "," + str.tostring(low) + "," + str.tostring(close) + "," + str.tostring(volume)),
     request.seed("seed_toodegrees_toogit", "TOODEGREES_FOREX_FACTORY_SLOT_5", str.tostring(open) + "," + str.tostring(high) + "," + str.tostring(low) + "," + str.tostring(close) + "," + str.tostring(volume)),
     request.seed("seed_toodegrees_toogit", "TOODEGREES_FOREX_FACTORY_SLOT_6", str.tostring(open) + "," + str.tostring(high) + "," + str.tostring(low) + "," + str.tostring(close) + "," + str.tostring(volume)),
     request.seed("seed_toodegrees_toogit", "TOODEGREES_FOREX_FACTORY_SLOT_7", str.tostring(open) + "," + str.tostring(high) + "," + str.tostring(low) + "," + str.tostring(close) + "," + str.tostring(volume)),
     request.seed("seed_toodegrees_toogit", "TOODEGREES_FOREX_FACTORY_SLOT_8", str.tostring(open) + "," + str.tostring(high) + "," + str.tostring(low) + "," + str.tostring(close) + "," + str.tostring(volume)),
     request.seed("seed_toodegrees_toogit", "TOODEGREES_FOREX_FACTORY_SLOT_9", str.tostring(open) + "," + str.tostring(high) + "," + str.tostring(low) + "," + str.tostring(close) + "," + str.tostring(volume))]

method processData(ffUtil.News[] news, string slot1, string slot2, string slot3, string slot4, string slot5, string slot6, string slot7, string slot8, string slot9) =>
    ffDec.readNews(news, slot1), ffDec.readNews(news, slot2), ffDec.readNews(news, slot3)
    ffDec.readNews(news, slot4), ffDec.readNews(news, slot5), ffDec.readNews(news, slot6)
    ffDec.readNews(news, slot7), ffDec.readNews(news, slot8), ffDec.readNews(news, slot9)


// ─────────────────────────────────────────────────────────────────────────────
// Tooltips
// ─────────────────────────────────────────────────────────────────────────────
string timezoneTooltip = "The feed is based on New York time. If your chart uses another timezone, enable this and match the fixed UTC offset shown at the bottom-right of the chart. Fixed offsets do not adjust automatically for daylight saving time."
string impactTooltip = "🔴 High impact\n🟠 Medium impact\n🟡 Low impact\n⚪ Holiday"
string autoCurrencyTooltip = "Automatically selects calendar currencies from the current chart symbol. For indices, futures, metals, or synthetic symbols, manual currency selection is safer."
string chartHistoryTooltip = "Today keeps only the current day's drawings. This Week keeps the current week's drawings. Manual also retains prior drawings for the selected number of calendar days."
string labelPositionTooltip = "Auto places the label opposite the event candle's direction."
string hoverMarkerTooltip = "Draws one compact circle on each bar containing a shaded release. Hover the circle for the event title, currency, schedule, expected impact, DXY rank, and shaded-window duration. Simultaneous releases are combined into one numbered marker."
string tableSizeTooltip = "Approximate maximum visible events: Tiny 46, Small 38, Normal 28, Large 20, Huge 11."
string tableHeaderTooltip = "Header text color / header background color"
string tableRowTooltip = "Past-event text / future-event text / row background"
string shadingTooltip = "The window overlaps every chart bar from the selected number of minutes before the event through the selected number after it. 30 + 30 produces a one-hour centered region. Use an intraday time-based chart for precise boundaries."
string customKeywordsTooltip = "Optional comma-separated title fragments, matched without case sensitivity. Examples: Unemployment Rate, JOLTS, Consumer Confidence"
string eventRankTooltip = "The numbered order reflects typical immediate USD/DXY volatility, not a guaranteed move. The surprise versus consensus, the policy regime, and the currency attached to the release can change the order."


