int alertBeforeMinutes = input.int(30, "Alert before", group = "Alerts", inline = "alertWindow", minval = 0, maxval = 1440)
int alertAfterMinutes = input.int(5, "Alert after", group = "Alerts", inline = "alertWindow", minval = 0, maxval = 1440)


// ─────────────────────────────────────────────────────────────────────────────
