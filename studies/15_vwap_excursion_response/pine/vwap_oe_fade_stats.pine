// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
indicator("Session VWAP OE + Fade Stats", shorttitle="VWAP OE Fade Stats", overlay=false, max_labels_count=500, max_polylines_count=50)

// --- Constants ---
MS_PER_DAY = 86400000
// Two most recent daily occurrences of each anchor, including across weekends.
const int VWAP_SESSIONS_DRAWN = 2

// --- Inputs ---
g_gen = "General Settings"
tz  = input.string("America/New_York", "Timezone", group=g_gen)
src = input.source(hlc3, "VWAP Source", group=g_gen)

g_asia = "Asia Session"
show_asia      = input.bool(true, "Show VWAP (last 2 sessions)", group=g_asia, inline="a_vis")
asia_col       = input.color(color.rgb(127, 23, 145), "", group=g_asia, inline="a_vis")
asia_vwap_sess = input.session("2000-0000", "Asia VWAP Session", group=g_asia)
asia_mult      = input.float(2.0, "Asia Sigma (σ)", minval=0.0, step=0.1, group=g_asia)

g_lon = "London Session"
show_lon      = input.bool(true, "Show VWAP (last 2 sessions)", group=g_lon, inline="l_vis")
lon_col       = input.color(color.rgb(230, 81, 0), "", group=g_lon, inline="l_vis")
lon_vwap_sess = input.session("0300-0800", "London VWAP Session", group=g_lon)
lon_mult      = input.float(2.0, "London Sigma (σ)", minval=0.0, step=0.1, group=g_lon)

g_ny = "NY Session"
show_ny      = input.bool(true, "Show VWAP (last 2 sessions)", group=g_ny, inline="n_vis")
ny_col       = input.color(color.rgb(5, 107, 20), "", group=g_ny, inline="n_vis")
ny_vwap_sess = input.session("0930-1600", "NY VWAP Session", group=g_ny)
ny_mult      = input.float(2.0, "NY Sigma (σ)", minval=0.0, step=0.1, group=g_ny)

g_sig = "Signal Marker Condition"
show_oe_markers = input.bool(true, "Show OE buy/sell markers (all loaded history)", group=g_sig, tooltip="Independent of VWAP line visibility. Original OE markers use the conditions below; accepted study trades use the separate FADE labels.")
sig_tf     = input.timeframe("", "Candle Timeframe", options=["", "1", "2", "5", "15", "30"], group=g_sig)
sig_cond   = input.string("Candle Close", "Candle Condition", options=["Candle Close", "Wick"], group=g_sig)
sig_offset = input.string("Current Candle", "Signal Placement", options=["Current Candle", "Next Candle"], group=g_sig)
buy_col    = input.color(#089981, "Buy Signal Color", group=g_sig)
sel_col    = input.color(#f23645, "Sell Signal Color", group=g_sig)

g_conf = "Confluence Settings"
show_confluence = input.bool(true, "Show Volume/Delta Confluence", group=g_conf)
volMult         = input.float(2.0, "Volume Spike Multiplier", group=g_conf)
deltaMult       = input.float(2.5, "Delta Surge Multiplier", group=g_conf)

g_tick_set = "TICK / Settings"
tickSource        = input.string("TICKQ", "TICK Source", options=["TICK", "TICKQ"], group=g_tick_set)
tickRefresh       = input.string("Chart", "Refresh Frequency", options=["Chart", "1", "5S", "15S", "30S", "1S"], group=g_tick_set)
tickUseExtremes   = input.bool(true, "Include High/Low Extremes", group=g_tick_set)
tickPrintDayValue = input.bool(true, "Print NHOD/NLOD Value", group=g_tick_set)
tickExt1          = input.int(800, "Extension 1", minval=1, group=g_tick_set)
tickExt2          = input.int(1000, "Extension 2", minval=1, group=g_tick_set)
tickExt3          = input.int(1200, "Extension 3", minval=1, group=g_tick_set)

g_tick_style = "TICK / Style"
tickPosColor = input.color(#f23645, "Positive TICK Color", inline="tick_colors", group=g_tick_style)
tickNegColor = input.color(#089981, "Negative TICK Color", inline="tick_colors", group=g_tick_style)
tickStyle    = input.string("Circles", "Marker Style", options=["Circles", "Triangles", "None"], group=g_tick_style)

g_alert = "Alerts"
alertTiming = input.string("Bar Close", "Alert Timing", options=["Bar Close", "Any Update"], group=g_alert)
alertAsiaOE = input.bool(true, "Asia OE Signal", inline="a_alert", group=g_alert)
alertAsiaTick = input.bool(true, "TICK Extreme", inline="a_alert", group=g_alert)
alertLonOE = input.bool(true, "London OE Signal", inline="l_alert", group=g_alert)
alertLonTick = input.bool(true, "TICK Extreme", inline="l_alert", group=g_alert)
alertNyOE = input.bool(true, "NY OE Signal", inline="n_alert", group=g_alert)
alertNyTick = input.bool(true, "TICK Extreme", inline="n_alert", group=g_alert)

// --- Helpers ---
f_in_session(string sess, string timezone) =>
    not na(time(timeframe.period, sess, timezone))

f_at_session_start(string sess) =>
    hour(time, tz) == int(str.tonumber(str.substring(sess, 0, 2))) and minute(time, tz) == int(str.tonumber(str.substring(sess, 2, 4)))

f_calc_values(bool inVwap, bool anchor, float mult) =>
    var float pv  = 0.0
    var float vv  = 0.0
    var float p2v = 0.0
    if anchor
        pv := src * volume, vv := volume, p2v := src * src * volume
    else if inVwap
        pv += src * volume, vv += volume, p2v += src * src * volume
    vwap = inVwap and vv > 0 ? pv / vv : na
    v_sd = inVwap and vv > 0 and not anchor ? math.sqrt(math.max(0, (p2v / vv) - math.pow(vwap, 2))) : 0.0
    up = not na(vwap) ? vwap + mult * v_sd : na
    dn = not na(vwap) ? vwap - mult * v_sd : na
    [vwap, up, dn, anchor, v_sd]

f_clean_p(bool show, bool anchor, float val) =>
    show and not anchor and not (anchor[1] == true) ? val : na

// Curves use bounded drawing objects, not plot/fill slots. Plot shapes below
// retain every historical signal; deleting a curve never deletes a marker.
type VwapSessionDrawing
    int anchorStart
    array<chart.point> centers
    array<chart.point> uppers
    array<chart.point> lowers
    polyline centerLine = na
    polyline upperLine = na
    polyline lowerLine = na

f_delete_vwap_lines(VwapSessionDrawing drawing) =>
    polyline.delete(drawing.centerLine)
    polyline.delete(drawing.upperLine)
    polyline.delete(drawing.lowerLine)

f_draw_vwap(bool enabled, bool inside, int anchorStart, float center, float upper, float lower, color centerColor, color upperColor, color lowerColor, bool drawCenter) =>
    // Each written call owns its own two-session queue. No fixed millisecond
    // cutoff: Friday survives a weekend until two later anchors are observed.
    var array<VwapSessionDrawing> sessions = array.new<VwapSessionDrawing>()
    if enabled and inside
        bool newAnchor = array.size(sessions) == 0
        if not newAnchor
            VwapSessionDrawing latest = array.get(sessions, array.size(sessions) - 1)
            newAnchor := latest.anchorStart != anchorStart
        if newAnchor
            array.push(sessions, VwapSessionDrawing.new(anchorStart, array.new<chart.point>(), array.new<chart.point>(), array.new<chart.point>()))
            if array.size(sessions) > VWAP_SESSIONS_DRAWN
                VwapSessionDrawing expired = array.shift(sessions)
                f_delete_vwap_lines(expired)
        if not na(center) and not na(upper) and not na(lower)
            VwapSessionDrawing current = array.get(sessions, array.size(sessions) - 1)
            array.push(current.centers, chart.point.from_time(time, center))
            array.push(current.uppers, chart.point.from_time(time, upper))
            array.push(current.lowers, chart.point.from_time(time, lower))
    // Recreate the retained curves at the chart edge, including live updates.
    // Ordinary var rollback keeps an unfinished candle from appending twice.
    if barstate.islast
        for drawing in sessions
            f_delete_vwap_lines(drawing)
            if array.size(drawing.centers) > 1
                if drawCenter
                    drawing.centerLine := polyline.new(drawing.centers, xloc=xloc.bar_time, line_color=centerColor, line_width=2, force_overlay=true)
                drawing.upperLine := polyline.new(drawing.uppers, xloc=xloc.bar_time, line_color=upperColor, line_width=1, force_overlay=true)
                drawing.lowerLine := polyline.new(drawing.lowers, xloc=xloc.bar_time, line_color=lowerColor, line_width=1, force_overlay=true)
    array.size(sessions)

f_newlines(int count) =>
    string result = ""
    if count > 0
        for i = 1 to count
            result += "\n"
    result

// --- Session VWAPs ---
aInV = f_in_session(asia_vwap_sess, tz), aAnc = aInV and (not aInV[1] or f_at_session_start(asia_vwap_sess))
[aV, aU, aD, aA, aSigma] = f_calc_values(aInV, aAnc, asia_mult)

lInV = f_in_session(lon_vwap_sess, tz), lAnc = lInV and (not lInV[1] or f_at_session_start(lon_vwap_sess))
[lV, lU, lD, lA, lSigma] = f_calc_values(lInV, lAnc, lon_mult)

nInV = f_in_session(ny_vwap_sess, tz), nAnc = nInV and (not nInV[1] or f_at_session_start(ny_vwap_sess))
[nV, nU, nD, nA, nSigma] = f_calc_values(nInV, nAnc, ny_mult)

// --- Signal Logic ---
[req_c, req_h, req_l] = request.security(syminfo.tickerid, sig_tf, [close, high, low], barmerge.gaps_off, barmerge.lookahead_off)
is_close = sig_cond == "Candle Close"

a_buy_base = aInV and (is_close ? req_c < aD and req_c[1] >= aD[1] : req_l < aD and req_l[1] >= aD[1])
a_sel_base = aInV and (is_close ? req_c > aU and req_c[1] <= aU[1] : req_h > aU and req_h[1] <= aU[1])

l_buy_base = lInV and (is_close ? req_c < lD and req_c[1] >= lD[1] : req_l < lD and req_l[1] >= lD[1])
l_sel_base = lInV and (is_close ? req_c > lU and req_c[1] <= lU[1] : req_h > lU and req_h[1] <= lU[1])

n_buy_base = nInV and (is_close ? req_c < nD and req_c[1] >= nD[1] : req_l < nD and req_l[1] >= nD[1])
n_sel_base = nInV and (is_close ? req_c > nU and req_c[1] <= nU[1] : req_h > nU and req_h[1] <= nU[1])

offset_bars = sig_offset == "Next Candle" ? 1 : 0

a_buy = a_buy_base[offset_bars]
a_sel = a_sel_base[offset_bars]
l_buy = l_buy_base[offset_bars]
l_sel = l_sel_base[offset_bars]
n_buy = n_buy_base[offset_bars]
n_sel = n_sel_base[offset_bars]

// --- Signals and markers: all loaded history, independent of curve retention ---
asia_buy_now = a_buy
asia_sel_now = a_sel
lon_buy_now  = l_buy
lon_sel_now  = l_sel
ny_buy_now   = n_buy
ny_sel_now   = n_sel

current_buy_signal = asia_buy_now or lon_buy_now or ny_buy_now
current_sel_signal = asia_sel_now or lon_sel_now or ny_sel_now

plotshape(show_oe_markers and asia_buy_now, "Asia Buy", shape.triangleup, location.belowbar, buy_col, size=size.tiny, force_overlay=true)
plotshape(show_oe_markers and asia_sel_now, "Asia Sell", shape.triangledown, location.abovebar, sel_col, size=size.tiny, force_overlay=true)
plotshape(show_oe_markers and lon_buy_now, "London Buy", shape.triangleup, location.belowbar, buy_col, size=size.tiny, force_overlay=true)
plotshape(show_oe_markers and lon_sel_now, "London Sell", shape.triangledown, location.abovebar, sel_col, size=size.tiny, force_overlay=true)
plotshape(show_oe_markers and ny_buy_now, "NY Buy", shape.triangleup, location.belowbar, buy_col, size=size.tiny, force_overlay=true)
plotshape(show_oe_markers and ny_sel_now, "NY Sell", shape.triangledown, location.abovebar, sel_col, size=size.tiny, force_overlay=true)

// --- Delta and Volume Confluence ---
any_signal = current_buy_signal or current_sel_signal
is_near_signal = math.sum(any_signal ? 1 : 0, 4) > 0
near_buy = math.sum(current_buy_signal ? 1 : 0, 4) > 0
near_sel = math.sum(current_sel_signal ? 1 : 0, 4) > 0

fp = request.footprint(1)
barDelta = not na(fp) ? fp.delta() : 0.0
dynDeltaThresh = ta.sma(math.abs(barDelta), 20) * deltaMult
volThresh = ta.sma(volume, 20) * volMult

has_delta_surge = not na(dynDeltaThresh) and math.abs(barDelta) >= dynDeltaThresh
has_vol_spike = volume >= volThresh
confluence_above = near_sel and not near_buy ? true : near_buy and not near_sel ? false : close <= open
confluence_line_count = (has_delta_surge ? 1 : 0) + (has_vol_spike ? 1 : 0)
show_confluence_label = show_confluence and is_near_signal and confluence_line_count > 0

if show_confluence_label
    string lblText = ""
    if has_delta_surge
        lblText += "Δ " + str.tostring(math.round(barDelta)) + "\n"
    if has_vol_spike
        lblText += "V " + str.tostring(volume, format.volume) + "\n"

    lblColor = barDelta > 0 ? buy_col : sel_col
    paddedText = confluence_above ? lblText + "\n" : "\n" + lblText

    label.new(
         bar_index,
         na,
         paddedText,
         yloc=confluence_above ? yloc.abovebar : yloc.belowbar,
         style=label.style_none,
         color=#00000000,
         textcolor=lblColor,
         size=size.tiny, force_overlay=true)

// --- TICK/TICKQ Bubble Logic ---
parsedTickFreq = tickRefresh == "Chart" ? timeframe.period : tickRefresh
[tickHigh, tickLow, tickClose] = request.security(tickSource, parsedTickFreq, [high, low, close])

tickValue = tickUseExtremes ? math.abs(tickHigh) > math.abs(tickLow) ? tickHigh : tickLow : tickClose
absTick = math.abs(tickValue)

var float tickSessionHigh = 0.0
var float tickSessionLow = 0.0
isNewDay = nz(ta.change(time("D"))) != 0

if isNewDay
    tickSessionHigh := tickValue
    tickSessionLow := tickValue
else
    tickSessionHigh := math.max(tickSessionHigh, tickValue)
    tickSessionLow := math.min(tickSessionLow, tickValue)

tickHighChange = ta.change(tickSessionHigh)
tickLowChange = ta.change(tickSessionLow)
isNewTickHigh = tickValue == tickSessionHigh and tickValue > tickExt1 and not isNewDay and tickHighChange != 0
isNewTickLow = tickValue == tickSessionLow and tickValue < -tickExt1 and not isNewDay and tickLowChange != 0

tickChar = tickStyle == "Circles" ? "●" : tickValue > 0 ? "▼" : "▲"
tickDots = if tickStyle == "None" or absTick < tickExt1
    ""
else
    absTick >= tickExt3 ? tickChar + "\n" + tickChar + "\n" + tickChar : absTick >= tickExt2 ? tickChar + "\n" + tickChar : tickChar

if tickDots != "" or isNewTickHigh or isNewTickLow
    tickAbove = tickValue > 0
    triangleOnTickSide = tickAbove ? current_sel_signal : current_buy_signal
    valuesOnTickSide = show_confluence_label and confluence_above == tickAbove

    // Each occupied line becomes clearance between the candle and the TICK marker.
    clearanceLines = (triangleOnTickSide ? 1 : 0) + (valuesOnTickSide ? confluence_line_count + 1 : 0)
    collisionPad = f_newlines(clearanceLines)
    tickValueText = str.tostring(tickValue, "#")
    string tickLabelText = ""

    if tickAbove
        tickLabelText := (isNewTickHigh and tickPrintDayValue ? tickValueText + "\n\n\n" : "") + tickDots + collisionPad
    else
        tickLabelText := collisionPad + tickDots + (isNewTickLow and tickPrintDayValue ? "\n\n\n" + tickValueText : "")

    if tickLabelText != ""
        label.new(
             bar_index,
             tickAbove ? high : low,
             tickLabelText,
             color=#00000000,
             style=tickAbove ? label.style_label_down : label.style_label_up,
             textcolor=tickAbove ? tickPosColor : tickNegColor,
             size=size.tiny, force_overlay=true)

// --- Dynamic Alerts ---
// Create one alert from TradingView using "Any alert() function call".
// Signal alerts use the active session's OE signal; TICK alerts use the
// session in which a new positive/negative extreme is recorded.
alertOnClose = alertTiming == "Bar Close"
alertFreq = alertOnClose ? alert.freq_once_per_bar_close : alert.freq_once_per_bar

asiaOEBuyAlert = alertAsiaOE and asia_buy_now
asiaOESellAlert = alertAsiaOE and asia_sel_now
lonOEBuyAlert = alertLonOE and lon_buy_now
lonOESellAlert = alertLonOE and lon_sel_now
nyOEBuyAlert = alertNyOE and ny_buy_now
nyOESellAlert = alertNyOE and ny_sel_now

asiaTickBuyAlert = alertAsiaTick and aInV and isNewTickHigh
asiaTickSellAlert = alertAsiaTick and aInV and isNewTickLow
lonTickBuyAlert = alertLonTick and lInV and isNewTickHigh
lonTickSellAlert = alertLonTick and lInV and isNewTickLow
nyTickBuyAlert = alertNyTick and nInV and isNewTickHigh
nyTickSellAlert = alertNyTick and nInV and isNewTickLow

string alertMessage = ""
if asiaOEBuyAlert
    alertMessage += "Asia Session: OE Buy\n"
if asiaOESellAlert
    alertMessage += "Asia Session: OE Sell\n"
if lonOEBuyAlert
    alertMessage += "London Session: OE Buy\n"
if lonOESellAlert
    alertMessage += "London Session: OE Sell\n"
if nyOEBuyAlert
    alertMessage += "NY Session: OE Buy\n"
if nyOESellAlert
    alertMessage += "NY Session: OE Sell\n"
if asiaTickBuyAlert
    alertMessage += "Asia Session: " + tickSource + " Extreme Buy\n"
if asiaTickSellAlert
    alertMessage += "Asia Session: " + tickSource + " Extreme Sell\n"
if lonTickBuyAlert
    alertMessage += "London Session: " + tickSource + " Extreme Buy\n"
if lonTickSellAlert
    alertMessage += "London Session: " + tickSource + " Extreme Sell\n"
if nyTickBuyAlert
    alertMessage += "NY Session: " + tickSource + " Extreme Buy\n"
if nyTickSellAlert
    alertMessage += "NY Session: " + tickSource + " Extreme Sell\n"

if alertMessage != ""
    alert(alertMessage, alertFreq)

plot(tickValue, "TICK Value", color.new(chart.fg_color, 100), display=display.data_window)

// === Chart-local configurable-sigma fade study; no saved Abacus probabilities ===
// Original OE plots/alerts above retain their own settings. The measured rule
// below uses confirmed two-minute CLOSES, the chosen sigma and moratorium.
const int FADE_MAX_HORIZON = 100
const int FADE_BAR_MS = 120000
const color FADE_BG = #161616
const color FADE_BORDER = #2E2E2E
const color FADE_MUTED = #999999
const color FADE_TEXT = #DBDBDB
const string FADE_GROUP = "VWAP Fade / Event study"
string fadeAnchorInput = input.string("Asia", "Anchor to study", options=["Asia", "London", "New York", "Globex", "Active local session"], group=FADE_GROUP, tooltip="Local anchors use the OE session inputs above, including their end times. Active local session pools the three local anchors; cooldowns remain independent per anchor. Choose one anchor for separate statistics.")
float fadeSigmaInput = input.float(2.0, "Fade band distance (σ)", minval=0.1, maxval=10.0, step=0.5, group=FADE_GROUP, tooltip="Use 2, 2.5, 3 or a custom positive distance. Sets both FADE signal thresholds, the studied envelope, Globex bands and all statistics. Original OE triangles and local OE bands keep their separate session sigma inputs.")
int fadeMoratoriumInput = input.int(0, "Session-start moratorium (minutes)", minval=0, maxval=1440, group=FADE_GROUP, tooltip="0 = off; 30 = skip the first half hour; 60 = skip the first hour. Custom minutes are allowed. FADE signals become eligible when the completed candle CLOSE reaches anchor time + this duration; a 20:00 anchor with 30 minutes first permits the 20:30 close. Resets independently for each anchor/session. VWAP still accumulates from the anchor. Paused signals never start cooldown. Original OE triangles/alerts are separate.")
string fadeSideInput = input.string("Both", "Fade direction", options=["Both", "Long only", "Short only"], group=FADE_GROUP, tooltip="Below the selected lower sigma band means long; above the upper band means short. Direction filtering happens before cooldown. Long and short share the selected anchor's cooldown.")
string fadeSignalInput = input.string("Every outside close", "Signal counting", options=["Every outside close", "Fresh band crossing only"], group=FADE_GROUP, tooltip="Every outside close matches the supplied stats indicator: each qualifying completed candle is a candidate. Fresh crossing requires the previous same-anchor close to be on/inside its contemporaneous band. Neither mode uses the proposed research plan's parent-excursion rule.")
int fadeCooldownInput = input.int(10, "Selected cooldown (candles)", options=[0, 5, 10, 20, 30], group=FADE_GROUP, tooltip="Suppress exactly the next N candles after an accepted signal. With 10, the next signal can be accepted 11 bars later. Rejected signals never restart cooldown. Each of the five comparison rows is simulated independently; clocks reset at each new anchor session.")
int fadeCompareInput = input.int(20, "Comparison horizon (candles)", options=[5, 10, 15, 20, 30, 50, 100], group=FADE_GROUP)
bool fadeSessionOnlyInput = input.bool(true, "Keep horizons inside anchor session", group=FADE_GROUP, tooltip="On: paths stop at their original session end; longer incomplete horizons are excluded, not losses. Off: paths may continue across session boundaries, but a missing 2-minute candle still cancels the unfinished path. Paths can overlap.")
int fadeFirstYearInput = input.int(2025, "First signal year", minval=2000, maxval=2100, group=FADE_GROUP)
int fadeLastYearInput = input.int(2026, "Last signal year", minval=2000, maxval=2100, group=FADE_GROUP, tooltip="Year selection uses the signal's completed close in the General Settings timezone. A qualified path may finish in the following year. Statistics use only loaded chart history.")

const string FADE_GLOBEX_GROUP = "VWAP Fade / Globex anchor"
string fadeGlobexSessionInput = input.session("1800-1700", "Globex window", group=FADE_GLOBEX_GROUP)
bool fadeShowGlobexInput = input.bool(false, "Show Globex VWAP and selected σ bands", group=FADE_GLOBEX_GROUP)
color fadeGlobexColorInput = input.color(color.blue, "Globex color", group=FADE_GLOBEX_GROUP)

const string FADE_STYLE_GROUP = "VWAP Fade / Display"
string fadeUnitsInput = input.string("Points", "Excursion units", options=["Points", "Ticks"], group=FADE_STYLE_GROUP)
color fadeMfeColorInput = input.color(#089981, "MFE / long", group=FADE_STYLE_GROUP)
color fadeMaeColorInput = input.color(#f23645, "MAE / short", group=FADE_STYLE_GROUP)
bool fadeShowMarkersInput = input.bool(true, "Show accepted FADE labels", group=FADE_STYLE_GROUP)
bool fadeShowEndsInput = input.bool(false, "Show measurement-end diamonds", group=FADE_STYLE_GROUP)
bool fadeShowBandInput = input.bool(true, "Show studied σ envelope", group=FADE_STYLE_GROUP, tooltip="Displays the chosen Fade band distance, even when an original OE multiplier differs. The envelope remains visible during the moratorium; only FADE signals are paused. Hiding visuals does not filter the statistics.")
bool fadeShowTagInput = input.bool(true, "Show study badge on price chart", group=FADE_STYLE_GROUP)
bool fadeShowCurveInput = input.bool(true, "Show horizon diagram", group=FADE_STYLE_GROUP)
int fadeSpacingInput = input.int(4, "Horizon diagram spacing", minval=1, maxval=10, group=FADE_STYLE_GROUP, tooltip="The lower-pane curves show average excursion by holding horizon, not a time series. Labels identify candle counts; ignore the chart's time-axis labels for these curves.")
bool fadeAlertsInput = input.bool(true, "Enable selected-cooldown fade alert conditions", group=FADE_STYLE_GROUP)
const string FADE_WEEK_GROUP = "VWAP Fade / Weekly opportunities"
bool fadeShowWeeksInput = input.bool(true, "Show weekly opportunities", group=FADE_WEEK_GROUP)
int fadeWeekRowsInput = input.int(6, "Weeks per page", minval=4, maxval=15, group=FADE_WEEK_GROUP)
int fadeWeekPageInput = input.int(1, "Week page (1 = latest)", minval=1, maxval=2000, group=FADE_WEEK_GROUP)

if barstate.isfirst
    if not chart.is_standard or timeframe.in_seconds() != 120
        runtime.error("VWAP OE Fade Stats requires standard 2-minute candles.")
    if fadeFirstYearInput > fadeLastYearInput
        runtime.error("First signal year must not be after last signal year.")

// Scalar helpers are also exercised directly by the local verification tests.
fadeDirection(float price, float center, float sigmaValue, bool freshOnly, bool previousValid, float previousPrice, float previousCenter, float previousSigma, float bandMultiple = 2.0) =>
    int direction = 0
    if not na(center) and not na(sigmaValue) and sigmaValue > 0
        if price < center - bandMultiple * sigmaValue
            if not freshOnly or (previousValid and previousPrice >= previousCenter - bandMultiple * previousSigma)
                direction := 1
        else if price > center + bandMultiple * sigmaValue
            if not freshOnly or (previousValid and previousPrice <= previousCenter + bandMultiple * previousSigma)
                direction := -1
    direction

fadeSignalEligible(bool valid, int signalClose, int anchorStart, int moratoriumMinutes) =>
    valid and signalClose - anchorStart >= moratoriumMinutes * 60000

fadeAccept(bool candidate, int currentBar, int lastAcceptedBar, int cooldown) =>
    candidate and currentBar - lastAcceptedBar > cooldown

fadeEntryAllowed(int pendingDirection, int pendingAt, int pendingEnd, int currentOpen, int currentClose, bool contiguous, bool fullBar, bool restrictSession) =>
    pendingDirection != 0 and currentOpen == pendingAt and contiguous and fullBar and (not restrictSession or currentClose <= pendingEnd)

fadePathValid(int currentClose, int originalEnd, bool contiguous, bool fullBar, bool restrictSession) =>
    contiguous and fullBar and (not restrictSession or currentClose <= originalEnd)

fadeExcursions(int direction, float entry, float minimumPrice, float maximumPrice, float terminalClose) =>
    float favorable = math.max(0.0, maximumPrice - entry)
    float adverse = math.max(0.0, entry - minimumPrice)
    if direction == -1
        favorable := math.max(0.0, entry - minimumPrice)
        adverse := math.max(0.0, maximumPrice - entry)
    float terminalDelta = direction * (terminalClose - entry)
    [favorable, adverse, terminalDelta]

fadeBounds(string sessionSpec) =>
    int startHour = int(str.tonumber(str.substring(sessionSpec, 0, 2)))
    int startMinute = int(str.tonumber(str.substring(sessionSpec, 2, 4)))
    int endHour = int(str.tonumber(str.substring(sessionSpec, 5, 7)))
    int endMinute = int(str.tonumber(str.substring(sessionSpec, 7, 9)))
    int startClock = startHour * 60 + startMinute
    int endClock = endHour * 60 + endMinute
    int clockNow = hour(time, tz) * 60 + minute(time, tz)
    bool overnight = endClock <= startClock
    int startDayOffset = overnight and clockNow < endClock ? -1 : 0
    // Equal start/end means a complete 24-hour session.
    if endClock == startClock and clockNow < startClock
        startDayOffset := -1
    int sessionStart = timestamp(tz, year(time, tz), month(time, tz), dayofmonth(time, tz) + startDayOffset, startHour, startMinute)
    int sessionEnd = timestamp(tz, year(time, tz), month(time, tz), dayofmonth(time, tz) + startDayOffset + (overnight ? 1 : 0), endHour, endMinute)
    [sessionStart, sessionEnd]

fadeCoverage(bool inside, int sessionStart) =>
    var int knownStart = na
    var bool complete = false
    if inside
        if na(knownStart) or sessionStart != knownStart
            knownStart := sessionStart
            complete := time == sessionStart
        else if time != time_close[1]
            complete := false
        if na(volume) or volume < 0 or na(src) or na(open) or na(high) or na(low) or na(close) or time_close - time != FADE_BAR_MS
            complete := false
    inside and complete

fadeWeekKey(int closeTimestamp) =>
    int daysSinceMonday = (dayofweek(closeTimestamp, tz) - dayofweek.monday + 7) % 7
    int dateKey = timestamp("UTC", year(closeTimestamp, tz), month(closeTimestamp, tz), dayofmonth(closeTimestamp, tz), 0, 0)
    dateKey - daysSinceMonday * MS_PER_DAY

fadeCooldownAt(int index) =>
    switch index
        0 => 0
        1 => 5
        2 => 10
        3 => 20
        => 30

fadeHorizonAt(int row) =>
    switch row
        1 => 5
        2 => 10
        3 => 15
        4 => 20
        5 => 30
        6 => 50
        => 100

type FadePath
    float entry
    float lowSeen
    float highSeen
    int direction
    int age
    int sessionEnd

type FadeCohort
    array<FadePath> paths
    array<float> mfe
    array<float> mae
    array<float> delta
    array<int> wins
    array<int> ties
    array<int> samples
    array<int> longs
    array<int> lastAccepted
    array<int> anchorStarts
    int pendingDirection = 0
    int pendingAt = 0
    int pendingEnd = 0
    int accepted = 0
    int entered = 0
    int cancelled = 0
    int truncated = 0

newFadeCohort() =>
    FadeCohort.new(array.new<FadePath>(), array.new<float>(FADE_MAX_HORIZON, 0.0), array.new<float>(FADE_MAX_HORIZON, 0.0), array.new<float>(FADE_MAX_HORIZON, 0.0), array.new<int>(FADE_MAX_HORIZON, 0), array.new<int>(FADE_MAX_HORIZON, 0), array.new<int>(FADE_MAX_HORIZON, 0), array.new<int>(FADE_MAX_HORIZON, 0), array.new<int>(4, -1000000), array.new<int>(4, 0))

bool fadeGIn = f_in_session(fadeGlobexSessionInput, tz)
bool fadeGAnchor = fadeGIn and (not fadeGIn[1] or f_at_session_start(fadeGlobexSessionInput))
[fadeGV, fadeGU, fadeGD, fadeGA, fadeGSigma] = f_calc_values(fadeGIn, fadeGAnchor, fadeSigmaInput)
[fadeAStart, fadeAEnd] = fadeBounds(asia_vwap_sess)
[fadeLStart, fadeLEnd] = fadeBounds(lon_vwap_sess)
[fadeNStart, fadeNEnd] = fadeBounds(ny_vwap_sess)
[fadeGStart, fadeGEnd] = fadeBounds(fadeGlobexSessionInput)
bool fadeACovered = fadeCoverage(aInV, fadeAStart)
bool fadeLCovered = fadeCoverage(lInV, fadeLStart)
bool fadeNCovered = fadeCoverage(nInV, fadeNStart)
bool fadeGCovered = fadeCoverage(fadeGIn, fadeGStart)
int fadeLocalCount = (aInV ? 1 : 0) + (lInV ? 1 : 0) + (nInV ? 1 : 0)
if fadeAnchorInput == "Active local session" and fadeLocalCount > 1
    runtime.error("Active local session requires non-overlapping OE session windows. Select one anchor or adjust the windows.")
int fadeAnchorId = switch fadeAnchorInput
    "Asia" => aInV ? 0 : -1
    "London" => lInV ? 1 : -1
    "New York" => nInV ? 2 : -1
    "Globex" => fadeGIn ? 3 : -1
    => aInV ? 0 : lInV ? 1 : nInV ? 2 : -1
float fadeVwap = fadeAnchorId == 0 ? aV : fadeAnchorId == 1 ? lV : fadeAnchorId == 2 ? nV : fadeAnchorId == 3 ? fadeGV : na
float fadeSigma = fadeAnchorId == 0 ? aSigma : fadeAnchorId == 1 ? lSigma : fadeAnchorId == 2 ? nSigma : fadeAnchorId == 3 ? fadeGSigma : na
int fadeAnchorStart = fadeAnchorId == 0 ? fadeAStart : fadeAnchorId == 1 ? fadeLStart : fadeAnchorId == 2 ? fadeNStart : fadeAnchorId == 3 ? fadeGStart : 0
int fadeAnchorEnd = fadeAnchorId == 0 ? fadeAEnd : fadeAnchorId == 1 ? fadeLEnd : fadeAnchorId == 2 ? fadeNEnd : fadeAnchorId == 3 ? fadeGEnd : 0
bool fadeCovered = fadeAnchorId == 0 ? fadeACovered : fadeAnchorId == 1 ? fadeLCovered : fadeAnchorId == 2 ? fadeNCovered : fadeAnchorId == 3 ? fadeGCovered : false
bool fadeContiguous = bar_index > 0 and time == time_close[1] and time - time[1] == FADE_BAR_MS
bool fadeFullBar = time_close - time == FADE_BAR_MS and not na(open) and not na(high) and not na(low) and not na(close)
bool fadeYearOk = year(time_close, tz) >= fadeFirstYearInput and year(time_close, tz) <= fadeLastYearInput
bool fadeSameAnchor = fadeAnchorId >= 0 and fadeAnchorId == fadeAnchorId[1] and fadeAnchorStart == fadeAnchorStart[1] and fadeContiguous
// Data validity is independent of the moratorium: retain early VWAP samples,
// and allow a fresh crossing at the first eligible close to use its prior bar.
bool fadeValid = fadeCovered and fadeFullBar and time_close <= fadeAnchorEnd and time > fadeAnchorStart and not na(fadeSigma) and fadeSigma > 0
int fadeDirectionNow = fadeDirection(close, fadeVwap, fadeSigma, fadeSignalInput == "Fresh band crossing only", fadeSameAnchor and fadeValid[1], close[1], fadeVwap[1], fadeSigma[1], fadeSigmaInput)
bool fadeSideOk = fadeSideInput == "Both" or (fadeSideInput == "Long only" and fadeDirectionNow == 1) or (fadeSideInput == "Short only" and fadeDirectionNow == -1)
bool fadeCandidate = barstate.isconfirmed and fadeSignalEligible(fadeValid, time_close, fadeAnchorStart, fadeMoratoriumInput) and fadeYearOk and fadeDirectionNow != 0 and fadeSideOk
bool fadeReady = fadeCandidate and (not fadeSessionOnlyInput or time_close < fadeAnchorEnd)
int fadeSelectedIndex = fadeCooldownInput == 0 ? 0 : fadeCooldownInput == 5 ? 1 : fadeCooldownInput == 10 ? 2 : fadeCooldownInput == 20 ? 3 : 4
var array<FadeCohort> fadeCohorts = array.new<FadeCohort>()
if barstate.isfirst
    for cohortIndex = 0 to 4
        array.push(fadeCohorts, newFadeCohort())

bool fadeSelectedLong = false
bool fadeSelectedShort = false
bool fadeSelectedEnd = false
bool fadeSelectedEntry = false
// Commit study state only at candle close. Pending entries use that candle's
// already-known open, then include exactly its own high/low as holding bar 1.
if barstate.isconfirmed
    for cohortIndex = 0 to 4
        FadeCohort cohort = array.get(fadeCohorts, cohortIndex)
        if cohort.pendingDirection != 0
            if fadeEntryAllowed(cohort.pendingDirection, cohort.pendingAt, cohort.pendingEnd, time, time_close, fadeContiguous, fadeFullBar, fadeSessionOnlyInput)
                array.push(cohort.paths, FadePath.new(open, open, open, cohort.pendingDirection, 0, cohort.pendingEnd))
                cohort.entered += 1
                if cohortIndex == fadeSelectedIndex
                    fadeSelectedEntry := true
            else
                cohort.cancelled += 1
            cohort.pendingDirection := 0

        int pathIndex = 0
        while pathIndex < array.size(cohort.paths)
            FadePath path = array.get(cohort.paths, pathIndex)
            if not fadePathValid(time_close, path.sessionEnd, fadeContiguous, fadeFullBar, fadeSessionOnlyInput)
                cohort.truncated += 1
                array.remove(cohort.paths, pathIndex)
            else
                path.lowSeen := math.min(path.lowSeen, low)
                path.highSeen := math.max(path.highSeen, high)
                path.age += 1
                int horizonIndex = path.age - 1
                [favorable, adverse, terminalDelta] = fadeExcursions(path.direction, path.entry, path.lowSeen, path.highSeen, close)
                array.set(cohort.mfe, horizonIndex, array.get(cohort.mfe, horizonIndex) + favorable)
                array.set(cohort.mae, horizonIndex, array.get(cohort.mae, horizonIndex) + adverse)
                array.set(cohort.delta, horizonIndex, array.get(cohort.delta, horizonIndex) + terminalDelta)
                array.set(cohort.wins, horizonIndex, array.get(cohort.wins, horizonIndex) + (terminalDelta > 0 ? 1 : 0))
                array.set(cohort.ties, horizonIndex, array.get(cohort.ties, horizonIndex) + (terminalDelta == 0 ? 1 : 0))
                array.set(cohort.samples, horizonIndex, array.get(cohort.samples, horizonIndex) + 1)
                array.set(cohort.longs, horizonIndex, array.get(cohort.longs, horizonIndex) + (path.direction == 1 ? 1 : 0))
                if cohortIndex == fadeSelectedIndex and path.age == fadeCompareInput
                    fadeSelectedEnd := true
                if path.age == FADE_MAX_HORIZON
                    array.remove(cohort.paths, pathIndex)
                else
                    pathIndex += 1

        // Queue new signals last: no signal candle contributes to its own path.
        if fadeAnchorId >= 0
            if array.get(cohort.anchorStarts, fadeAnchorId) != fadeAnchorStart
                array.set(cohort.anchorStarts, fadeAnchorId, fadeAnchorStart)
                array.set(cohort.lastAccepted, fadeAnchorId, -1000000)
            if fadeAccept(fadeReady, bar_index, array.get(cohort.lastAccepted, fadeAnchorId), fadeCooldownAt(cohortIndex))
                array.set(cohort.lastAccepted, fadeAnchorId, bar_index)
                cohort.pendingDirection := fadeDirectionNow
                cohort.pendingAt := time_close
                cohort.pendingEnd := fadeAnchorEnd
                cohort.accepted += 1
                if cohortIndex == fadeSelectedIndex
                    fadeSelectedLong := fadeDirectionNow == 1
                    fadeSelectedShort := fadeDirectionNow == -1

FadeCohort fadeSelected = array.get(fadeCohorts, fadeSelectedIndex)
float fadeDivisor = fadeUnitsInput == "Ticks" ? syminfo.mintick : 1.0
var array<int> fadeWeekDates = array.new<int>()
var array<int> fadeWeekCandidates = array.new<int>()
var array<int> fadeWeekReady = array.new<int>()
var array<int> fadeWeekLongs = array.new<int>()
var array<int> fadeWeekShorts = array.new<int>()
var array<int> fadeWeekBars = array.new<int>()
if barstate.isconfirmed and fadeYearOk and fadeAnchorId >= 0
    int weekKey = fadeWeekKey(time_close)
    int weekCount = array.size(fadeWeekDates)
    bool newWeek = weekCount == 0
    if weekCount > 0
        newWeek := array.get(fadeWeekDates, weekCount - 1) != weekKey
    if newWeek
        array.push(fadeWeekDates, weekKey)
        array.push(fadeWeekCandidates, 0)
        array.push(fadeWeekReady, 0)
        array.push(fadeWeekLongs, 0)
        array.push(fadeWeekShorts, 0)
        array.push(fadeWeekBars, 0)
    int weekIndex = array.size(fadeWeekDates) - 1
    array.set(fadeWeekBars, weekIndex, array.get(fadeWeekBars, weekIndex) + 1)
    if fadeCandidate
        array.set(fadeWeekCandidates, weekIndex, array.get(fadeWeekCandidates, weekIndex) + 1)
    if fadeReady
        array.set(fadeWeekReady, weekIndex, array.get(fadeWeekReady, weekIndex) + 1)
    if fadeSelectedLong
        array.set(fadeWeekLongs, weekIndex, array.get(fadeWeekLongs, weekIndex) + 1)
    if fadeSelectedShort
        array.set(fadeWeekShorts, weekIndex, array.get(fadeWeekShorts, weekIndex) + 1)

// At most 24 original VWAP/band polylines + 16 studied-band polylines +
// 2 lower-pane horizon curves = 42, within max_polylines_count=50.
// No VWAP plot slots or invisible gradient fills. Keep the signal plotshapes
// below independent of these two-session queues and their visibility inputs.
f_draw_vwap(show_asia, aInV, fadeAStart, f_clean_p(true, aA, aV), aU, aD, asia_col, color.new(asia_col, 50), color.new(asia_col, 50), true)
f_draw_vwap(show_lon, lInV, fadeLStart, f_clean_p(true, lA, lV), lU, lD, lon_col, color.new(lon_col, 50), color.new(lon_col, 50), true)
f_draw_vwap(show_ny, nInV, fadeNStart, f_clean_p(true, nA, nV), nU, nD, ny_col, color.new(ny_col, 50), color.new(ny_col, 50), true)
f_draw_vwap(fadeShowGlobexInput, fadeGIn, fadeGStart, fadeGV, fadeGU, fadeGD, fadeGlobexColorInput, color.new(fadeGlobexColorInput, 50), color.new(fadeGlobexColorInput, 50), true)
float fadeBandCenter = fadeValid ? fadeVwap : na
float fadeBandUpper = fadeValid ? fadeVwap + fadeSigmaInput * fadeSigma : na
float fadeBandLower = fadeValid ? fadeVwap - fadeSigmaInput * fadeSigma : na
f_draw_vwap(fadeShowBandInput, fadeAnchorId == 0, fadeAStart, fadeBandCenter, fadeBandUpper, fadeBandLower, color.white, color.new(fadeMaeColorInput, 20), color.new(fadeMfeColorInput, 20), false)
f_draw_vwap(fadeShowBandInput, fadeAnchorId == 1, fadeLStart, fadeBandCenter, fadeBandUpper, fadeBandLower, color.white, color.new(fadeMaeColorInput, 20), color.new(fadeMfeColorInput, 20), false)
f_draw_vwap(fadeShowBandInput, fadeAnchorId == 2, fadeNStart, fadeBandCenter, fadeBandUpper, fadeBandLower, color.white, color.new(fadeMaeColorInput, 20), color.new(fadeMfeColorInput, 20), false)
f_draw_vwap(fadeShowBandInput, fadeAnchorId == 3, fadeGStart, fadeBandCenter, fadeBandUpper, fadeBandLower, color.white, color.new(fadeMaeColorInput, 20), color.new(fadeMfeColorInput, 20), false)
plotshape(fadeShowMarkersInput and fadeSelectedLong, "Accepted fade LONG", shape.labelup, location.belowbar, fadeMfeColorInput, text="FADE\nLONG", textcolor=color.white, size=size.tiny, force_overlay=true)
plotshape(fadeShowMarkersInput and fadeSelectedShort, "Accepted fade SHORT", shape.labeldown, location.abovebar, fadeMaeColorInput, text="FADE\nSHORT", textcolor=color.white, size=size.tiny, force_overlay=true)
plot(fadeShowMarkersInput and fadeSelectedEntry ? open : na, "Fade next-open reference", color.aqua, 3, plot.style_circles, force_overlay=true)
plotshape(fadeShowEndsInput and fadeSelectedEnd, "Fade measurement horizon ends", shape.diamond, location.abovebar, color.silver, size=size.tiny, force_overlay=true)
alertcondition(fadeAlertsInput and fadeSelectedLong, "VWAP fade LONG", "Confirmed 2-minute close below the configured lower sigma band on {{ticker}}. Session-start moratorium complete; selected cooldown accepted. Hypothetical entry: next contiguous open.")
alertcondition(fadeAlertsInput and fadeSelectedShort, "VWAP fade SHORT", "Confirmed 2-minute close above the configured upper sigma band on {{ticker}}. Session-start moratorium complete; selected cooldown accepted. Hypothetical entry: next contiguous open.")
hline(0, "Fade entry / zero excursion", color=FADE_MUTED, linestyle=hline.style_dotted)

fadeCell(table panel, int column, int row, string value, color textColor, color background, string hint) =>
    table.cell(panel, column, row, value, text_color=textColor, bgcolor=background, text_size=size.tiny, tooltip=hint)

fadeMean(array<float> values, array<int> samples, int index) =>
    int count = array.get(samples, index)
    count > 0 ? str.tostring(array.get(values, index) / count / fadeDivisor, "#.##") : "—"

fadeWinText(FadeCohort cohort, int index) =>
    int count = array.get(cohort.samples, index)
    count > 0 ? str.tostring(100.0 * array.get(cohort.wins, index) / count, "#.0") + "%" : "—"

fadeSupport(FadeCohort cohort, int index) =>
    int count = array.get(cohort.samples, index)
    int longs = array.get(cohort.longs, index)
    int favorable = array.get(cohort.wins, index)
    int ties = array.get(cohort.ties, index)
    "Complete " + str.tostring(index + 1) + "-candle paths: " + str.tostring(count) + ". Long " + str.tostring(longs) + ", short " + str.tostring(count - longs) + ". Favorable close " + str.tostring(favorable) + ", adverse close " + str.tostring(count - favorable - ties) + ", ties " + str.tostring(ties) + ". Percentages include ties in the denominator. Earlier completed horizons survive later missing bars or session truncation. These are price paths, not executed trades."

var table fadeTag = table.new(position.top_left, 1, 3, frame_color=FADE_BORDER, frame_width=1, force_overlay=true)
var table fadeResults = table.new(position.middle_left, 6, 11, bgcolor=FADE_BG, frame_color=FADE_BORDER, frame_width=1, border_color=FADE_BORDER, border_width=1)
var table fadeCompare = table.new(position.top_right, 6, 7, bgcolor=FADE_BG, frame_color=FADE_BORDER, frame_width=1, border_color=FADE_BORDER, border_width=1)
var table fadeWeekly = table.new(position.bottom_right, 6, fadeWeekRowsInput + 3, bgcolor=FADE_BG, frame_color=FADE_BORDER, frame_width=1, border_color=FADE_BORDER, border_width=1)
if barstate.islast
    string sessionLabel = fadeAnchorInput == "Asia" ? asia_vwap_sess : fadeAnchorInput == "London" ? lon_vwap_sess : fadeAnchorInput == "New York" ? ny_vwap_sess : fadeAnchorInput == "Globex" ? fadeGlobexSessionInput : "locals pooled"
    string sigmaLabel = str.tostring(fadeSigmaInput, "#.##") + "σ"
    string pauseLabel = "Pause " + str.tostring(fadeMoratoriumInput) + "m"
    string descriptor = fadeAnchorInput + " " + sessionLabel + " | " + fadeSideInput + " | C" + str.tostring(fadeCooldownInput)
    string mechanics = sigmaLabel + " | " + pauseLabel + " | " + fadeSignalInput + " | next open | " + (fadeSessionOnlyInput ? "within session" : "cross-session")
    if fadeShowTagInput
        fadeCell(fadeTag, 0, 0, "VWAP OE • " + sigmaLabel + " FADE • 2m", color.white, #263238, "Original OE markers and alerts retain their own settings. Only FADE labels correspond to these stats.")
        fadeCell(fadeTag, 0, 1, descriptor, FADE_TEXT, FADE_BG, "Timezone: " + tz)
        fadeCell(fadeTag, 0, 2, mechanics, FADE_MUTED, FADE_BG, "Chart-local history; no saved Abacus rates. Δ is direction-adjusted price change, not footprint volume delta.")
    else
        table.clear(fadeTag, 0, 0, 0, 2)

    array<string> titles = array.from("CANDLES", "SAMPLES", "AVG MFE", "AVG MAE", "FADE CLOSE Δ", "FAVORABLE CLOSE")
    for column = 0 to 5
        fadeCell(fadeResults, column, 0, array.get(titles, column), column == 2 ? fadeMfeColorInput : column == 3 ? fadeMaeColorInput : FADE_MUTED, FADE_BG, "Long: favorable close > entry. Short: favorable close < entry. Δ = direction × (horizon close − entry open). MAE/MFE are positive magnitudes.")
    for row = 1 to 7
        int horizonIndex = fadeHorizonAt(row) - 1
        string hint = fadeSupport(fadeSelected, horizonIndex)
        fadeCell(fadeResults, 0, row, str.tostring(horizonIndex + 1), FADE_TEXT, FADE_BG, str.tostring(2 * (horizonIndex + 1)) + " elapsed minutes on contiguous 2m bars")
        fadeCell(fadeResults, 1, row, str.tostring(array.get(fadeSelected.samples, horizonIndex)), FADE_TEXT, FADE_BG, hint)
        fadeCell(fadeResults, 2, row, fadeMean(fadeSelected.mfe, fadeSelected.samples, horizonIndex), fadeMfeColorInput, FADE_BG, hint)
        fadeCell(fadeResults, 3, row, fadeMean(fadeSelected.mae, fadeSelected.samples, horizonIndex), fadeMaeColorInput, FADE_BG, hint)
        fadeCell(fadeResults, 4, row, fadeMean(fadeSelected.delta, fadeSelected.samples, horizonIndex), array.get(fadeSelected.delta, horizonIndex) >= 0 ? fadeMfeColorInput : fadeMaeColorInput, FADE_BG, hint)
        fadeCell(fadeResults, 5, row, fadeWinText(fadeSelected, horizonIndex), FADE_TEXT, FADE_BG, hint)
    array<string> settings = array.from(str.upper(fadeUnitsInput), fadeAnchorInput, fadeSideInput, "C" + str.tostring(fadeCooldownInput) + " | " + sigmaLabel, str.tostring(fadeFirstYearInput) + "–" + str.tostring(fadeLastYearInput), pauseLabel)
    array<string> limitations = array.from("LOADED HISTORY", "No costs / fills", "Overlapping paths", "Ties included", "Δ = price change", "Per-horizon samples")
    array<string> flow = array.from("Accepted " + str.tostring(fadeSelected.accepted), "Entered " + str.tostring(fadeSelected.entered), "Cancelled " + str.tostring(fadeSelected.cancelled), "Truncated " + str.tostring(fadeSelected.truncated), "Active " + str.tostring(array.size(fadeSelected.paths)), fadeSelected.pendingDirection != 0 ? "Pending 1" : "Pending 0")
    for column = 0 to 5
        fadeCell(fadeResults, column, 8, array.get(settings, column), FADE_MUTED, FADE_BG, descriptor + " | " + mechanics + " | " + tz)
        fadeCell(fadeResults, column, 9, array.get(limitations, column), FADE_MUTED, FADE_BG, "Longer horizons may have fewer complete paths. Mean curves need not be monotone when their cohorts differ. Not a P&L backtest or trade win rate.")
        fadeCell(fadeResults, column, 10, array.get(flow, column), FADE_MUTED, FADE_BG, "Accepted signals include pending next-open entries. Cancelled: next contiguous entry unavailable. Truncated: entered paths stopped before 100 candles by missing data or the selected session rule; their earlier completed horizons remain counted.")

    array<string> compareTitles = array.from("COOL / " + str.tostring(fadeCompareInput) + " BARS", "SAMPLES", "FAVORABLE CLOSE", "FADE CLOSE Δ", "AVG MFE", "AVG MAE")
    for column = 0 to 5
        fadeCell(fadeCompare, column, 0, array.get(compareTitles, column), FADE_MUTED, FADE_BG, "Independent cooldown simulations at one common measurement horizon. They need not select the same signals.")
    for cohortIndex = 0 to 4
        FadeCohort cohort = array.get(fadeCohorts, cohortIndex)
        int index = fadeCompareInput - 1
        int cooldown = fadeCooldownAt(cohortIndex)
        int row = cohortIndex + 1
        color background = cooldown == fadeCooldownInput ? color.new(fadeMfeColorInput, 85) : FADE_BG
        string hint = fadeSupport(cohort, index)
        fadeCell(fadeCompare, 0, row, str.tostring(cooldown) + " bars", FADE_TEXT, background, "Skips the next " + str.tostring(cooldown) + " bars after acceptance; does not block on open paths.")
        fadeCell(fadeCompare, 1, row, str.tostring(array.get(cohort.samples, index)), FADE_TEXT, background, hint)
        fadeCell(fadeCompare, 2, row, fadeWinText(cohort, index), FADE_TEXT, background, hint)
        fadeCell(fadeCompare, 3, row, fadeMean(cohort.delta, cohort.samples, index), array.get(cohort.delta, index) >= 0 ? fadeMfeColorInput : fadeMaeColorInput, background, hint)
        fadeCell(fadeCompare, 4, row, fadeMean(cohort.mfe, cohort.samples, index), fadeMfeColorInput, background, hint)
        fadeCell(fadeCompare, 5, row, fadeMean(cohort.mae, cohort.samples, index), fadeMaeColorInput, background, hint)
    for column = 0 to 5
        fadeCell(fadeCompare, column, 6, column == 0 ? "LONG + SHORT CD" : column == 1 ? "Shared per anchor" : column == 2 ? "Reset each session" : column == 3 ? "Rejected ≠ reset" : column == 4 ? fadeUnitsInput : sigmaLabel + " | " + pauseLabel, FADE_MUTED, FADE_BG, "Direction, sigma and moratorium selection apply before all five cooldown cohorts. A fresh session restarts its anchor's cooldown.")

    if fadeShowWeeksInput
        int weekCount = array.size(fadeWeekDates)
        int pages = math.max(1, int(math.ceil(float(weekCount) / fadeWeekRowsInput)))
        int page = math.min(fadeWeekPageInput, pages)
        array<string> weekTitles = array.from("WEEK / MON", "CANDIDATES", "ENTRY READY", "ACCEPTED LONG", "ACCEPTED SHORT", "LOADED BARS")
        for column = 0 to 5
            fadeCell(fadeWeekly, column, 0, array.get(weekTitles, column), FADE_MUTED, FADE_BG, "Signal-close weeks in " + tz + ". Candidates pass the chosen signal rule. Ready also has room for an entry before session end. Accepted uses the selected cooldown, before eventual entry/path completion.")
        array<string> totals = array.from("Page " + str.tostring(page) + "/" + str.tostring(pages), "Σ " + str.tostring(weekCount > 0 ? array.sum(fadeWeekCandidates) : 0), "Σ " + str.tostring(weekCount > 0 ? array.sum(fadeWeekReady) : 0), "Σ " + str.tostring(weekCount > 0 ? array.sum(fadeWeekLongs) : 0), "Σ " + str.tostring(weekCount > 0 ? array.sum(fadeWeekShorts) : 0), "Σ " + str.tostring(weekCount > 0 ? array.sum(fadeWeekBars) : 0))
        for column = 0 to 5
            fadeCell(fadeWeekly, column, 1, array.get(totals, column), FADE_TEXT, FADE_BG, "Totals cover loaded weeks only; zero-opportunity weeks with loaded selected-session bars are retained.")
        for offset = 0 to fadeWeekRowsInput - 1
            int weekIndex = weekCount - 1 - (page - 1) * fadeWeekRowsInput - offset
            int row = offset + 2
            bool available = weekIndex >= 0
            fadeCell(fadeWeekly, 0, row, available ? str.format_time(array.get(fadeWeekDates, weekIndex), "yyyy-MM-dd", "UTC") : "—", FADE_TEXT, FADE_BG, "Calendar-week starting date, not an exchange session date.")
            fadeCell(fadeWeekly, 1, row, available ? str.tostring(array.get(fadeWeekCandidates, weekIndex)) : "—", FADE_TEXT, FADE_BG, "")
            fadeCell(fadeWeekly, 2, row, available ? str.tostring(array.get(fadeWeekReady, weekIndex)) : "—", FADE_TEXT, FADE_BG, "")
            fadeCell(fadeWeekly, 3, row, available ? str.tostring(array.get(fadeWeekLongs, weekIndex)) : "—", fadeMfeColorInput, FADE_BG, "")
            fadeCell(fadeWeekly, 4, row, available ? str.tostring(array.get(fadeWeekShorts, weekIndex)) : "—", fadeMaeColorInput, FADE_BG, "")
            fadeCell(fadeWeekly, 5, row, available ? str.tostring(array.get(fadeWeekBars, weekIndex)) : "—", FADE_TEXT, FADE_BG, "Loaded selected-session bars, including bars excluded from signal eligibility.")
        for column = 0 to 5
            fadeCell(fadeWeekly, column, fadeWeekRowsInput + 2, column == 0 ? "MON–SUN" : column == 1 ? tz : column == 2 ? "Partial weeks possible" : column == 3 ? "Selected C" + str.tostring(fadeCooldownInput) : column == 4 ? sigmaLabel : pauseLabel, FADE_MUTED, FADE_BG, "Changing inputs recalculates all chart-local statistics.")
    else
        table.clear(fadeWeekly, 0, 0, 5, fadeWeekRowsInput + 2)

// As in the supplied reference, horizontal position encodes holding horizon.
var polyline fadeMfeLine = na
var polyline fadeMaeLine = na
var array<label> fadeHorizonLabels = array.new<label>()
if barstate.islast
    if not na(fadeMfeLine)
        polyline.delete(fadeMfeLine)
    if not na(fadeMaeLine)
        polyline.delete(fadeMaeLine)
    for oldLabel in fadeHorizonLabels
        label.delete(oldLabel)
    array.clear(fadeHorizonLabels)
    if fadeShowCurveInput and bar_index >= FADE_MAX_HORIZON - 1
        int spacing = math.min(fadeSpacingInput, int(math.floor(bar_index / (FADE_MAX_HORIZON - 1))))
        array<chart.point> favorablePoints = array.new<chart.point>()
        array<chart.point> adversePoints = array.new<chart.point>()
        for candle = 1 to FADE_MAX_HORIZON
            int index = candle - 1
            int count = array.get(fadeSelected.samples, index)
            if count > 0 and (candle == 1 or candle % 5 == 0)
                int x = bar_index - (FADE_MAX_HORIZON - candle) * spacing
                float averageMfe = array.get(fadeSelected.mfe, index) / count / fadeDivisor
                float averageMae = array.get(fadeSelected.mae, index) / count / fadeDivisor
                array.push(favorablePoints, chart.point.from_index(x, averageMfe))
                array.push(adversePoints, chart.point.from_index(x, -averageMae))
                if candle == 5 or candle == 10 or candle == 15 or candle == 20 or candle == 30 or candle == 50 or candle == 100
                    label marker = label.new(x, 0, str.tostring(candle), style=label.style_none, textcolor=FADE_MUTED, size=size.tiny, tooltip="Holding horizon: " + str.tostring(candle) + " candles / " + str.tostring(2 * candle) + " minutes. " + fadeSupport(fadeSelected, index))
                    array.push(fadeHorizonLabels, marker)
        if array.size(favorablePoints) > 1
            fadeMfeLine := polyline.new(favorablePoints, line_color=fadeMfeColorInput, line_width=3)
            fadeMaeLine := polyline.new(adversePoints, line_color=fadeMaeColorInput, line_width=3)
