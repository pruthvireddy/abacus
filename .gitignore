# Machine-specific state and dependencies
.DS_Store
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.tools/
.uv-cache/
.env
.env.*
*.key
config/paths.local.toml
# Bulk inputs and caches remain outside Git history.
/data/*
!/data/README.md
