/legacy/sahadeva/data/*.csv
/legacy/sahadeva/work
/legacy/bhishma/data
/legacy/bhishma/.venv
# Large future research evidence is retained via artifact manifests.
/runs/**/events/
/runs/**/*.parquet
/runs/**/logs/
